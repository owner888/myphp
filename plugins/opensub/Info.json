{
  "name": "OpenSubtitles",
  "identifier": "io.myphp.opensub",
  "version": "1.0.0",
  "description": "Official OpenSubtitles plugin for myphp",
  "author": {
    "name": "myphp Developers",
    "url": "https://github.com/owner888/myphp"
  },
  "entry": "main.php",
  "globalEntry": "global.php",
  "permissions": [
    "show-osd",
    "file-system",
    "network-request"
  ],
  "allowedDomains": [
    "*"
  ],
  "sidebarTab": {
    "name": "OpenSubtitles"
  },
  "subtitleProviders": [
    {
      "id": "open-sub",
      "name": "OpenSubtitles"
    }
  ],
  "preferencesPage": "pref.html",
  "preferenceDefaults": {
    "languages": "",
    "save_login": "keychain"
  },
  "localized": {
    "zh-Hans": {
      "description": "myphp 的 OpenSubtitles 官方插件"
    },
    "zh-Hant": {
      "description": "myphp 的 OpenSubtitles 官方外掛"
    },
    "ja": {
      "description": "myphp 用の OpenSubtitles 公式プラグイン"
    }
  }
}
