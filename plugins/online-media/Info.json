{
  "name": "Online Media",
  "identifier": "io.myphp.ytdl",
  "version": "1.0.0",
  "ghRepo": "owner888/myphp-plugin-online-media",
  "ghVersion": 1,
  "description": "Official plugin for playing online media via yt-dlp / youtube-dl. The built-in youtube-dl support will be disabled when this plugin is enabled.",
  "author": {
    "name": "myphp Developers",
    "url": "https://github.com/owner888/myphp-plugin-online-media"
  },
  "entry": "main.php",
  "globalEntry": "global.php",
  "permissions": ["show-osd", "file-system", "network-request"],
  "allowedDomains": ["github.com"],
  "preferencesPage": "pref.html",
  "preferenceDefaults": {
    "ytdl_path": "",
    "js_runtime": "",
    "excluded_urls": "",
    "try_ytdl_first": false,
    "use_manifests": false,
    "raw_options": "",
    "include_subs": true,
    "include_auto_subs": false,
    "video_quality": "best",
    "max_video_height": 1080,
    "custom_ytdl_format": "",
    "ytdl_format": ""
  }
}
