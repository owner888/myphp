<?php
declare(strict_types=1);

use MyPHP\{App, Window, WindowOptions};
use MyPHP\UI\Content;

require __DIR__ . '/boot.php';

/** The app's state: view.php shows it and changes it, as $this. */
final class Counter
{
    public int $count = 0;
}

$state = new Counter();

App::setName({{php:name}});
App::whenReady(function () use ($state) {
    new Window(new WindowOptions(title: {{php:name}}, width: 420, height: 260,
        content: Content::file(__DIR__ . '/view.php', $state)));
});
App::run();
