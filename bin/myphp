#!/usr/bin/env php
<?php
// The MyPHP command line, as mygo's: create a project, run it while
// developing, build its app. Pure PHP, no dependencies. `myphp help` lists
// the commands, `myphp <command> -h` the flags of one.
declare(strict_types=1);

const FRAMEWORK = __DIR__ . '/..';
const VERSION = '1.156.0';
const CONFIG = 'myphp.json';
const PHP_FLAGS = ['-d', 'ffi.enable=1', '-d', 'opcache.enable_cli=1', '-d', 'opcache.jit_buffer_size=64M', '-d', 'opcache.jit=1255', '-d', 'memory_limit=512M'];
const USAGE = <<<'TXT'
myphp is the tool for MyPHP desktop applications.

Usage:

	myphp <command> [arguments]

Commands:

	init <dir>           create a new project (native UI, or a web frontend)
	install-skills [dir] install or update the bundled MyPHP agent skills
	generate             write the typed TypeScript client for bound PHP services,
	                     and the accessors of the app's catalogs of messages
	i18n check [dir]     check the app's catalogs of messages
	dev                  run the app in development, restarting it on changes
	build                build production apps (a .app and a .dmg, Linux packages)
	screenshot [dir]     run the app once and save a PNG of its window, and its elements
	micro                build the static PHP that apps built with -launcher micro run on
	keygen               create the key pair that signs updates
	doctor               check that the development environment is ready
	version              print the MyPHP version

Run "myphp <command> -h" for the flags of a command.

TXT;

require FRAMEWORK . '/src/autoload.php';

use MyPHP\Native\Build\{Bundle, Cmd, Codesign, Deb, Dmg, Icns, Linux, MachO, Pkgbuild, Resources, Slug, Strings, Upload};

/** What a command failed of: main prints it and exits with 1; myphp dev reports a failed build and goes on. */
final class Failure extends RuntimeException {}

function fail(string $msg): never
{
    throw new Failure($msg);
}

/** Prints a step done or a note, as mygo's logf. */
function logf(string $msg): void
{
    echo "myphp: $msg\n";
}

/** Prints a warning, as mygo's warnf. */
function warnf(string $msg): void
{
    fwrite(STDERR, "myphp: warning: $msg\n");
}

/** The value of the flag -$name or --$name ("-name v", "-name=v"), taken out of $args, or $default (Go's flag package, which mygo's commands use). */
function option(array &$args, string $name, ?string $default = null): ?string
{
    foreach ($args as $i => $a) {
        if (($a === "--$name" || $a === "-$name") && isset($args[$i + 1])) {
            $v = $args[$i + 1];
            array_splice($args, $i, 2);
            return $v;
        }
        foreach (["--$name=", "-$name="] as $p) {
            if (str_starts_with($a, $p)) {
                array_splice($args, $i, 1);
                return substr($a, strlen($p));
            }
        }
    }
    return $default;
}

/** Whether the boolean flag -$name or --$name is given ("-name", "-name=true"), taken out of $args. */
function flag(array &$args, string $name): bool
{
    foreach ($args as $i => $a) {
        foreach (["--$name", "-$name"] as $f) {
            if ($a === $f || $a === "$f=true" || $a === "$f=false") {
                array_splice($args, $i, 1);
                return $a !== "$f=false";
            }
        }
    }
    return false;
}

/** Prints the usage of a command and exits when -h or --help is among its arguments. */
function help(array $args, string $usage): void
{
    if (in_array('-h', $args, true) || in_array('--help', $args, true) || in_array('-help', $args, true)) {
        echo "Usage: myphp $usage\n";
        exit(0);
    }
}

/** $s, or $or when it is empty: never ?: on a string that may be "0" (mygo's or). */
function orElse(string $s, string $or): string
{
    return $s === '' ? $or : $s;
}

/** The MyPHP checkout the project runs on: its configuration's framework, else this command's (which boot.php is told as MYPHP_HOME). */
function frameworkOf(array $c): string
{
    return realpath($c['framework'] ?? FRAMEWORK) ?: fail('framework ' . $c['framework'] . ' does not exist');
}

/** $p made absolute against the project's directory. */
function path(string $dir, string $p): string
{
    return str_starts_with($p, '/') ? $p : "$dir/$p";
}

const CONFIG_TS = 'myphp.config.ts';
const CONFIG_LOADER = <<<'JS'
import { writeFileSync } from "node:fs";
import { pathToFileURL } from "node:url";

const mod = await import(pathToFileURL(process.env.MYPHP_CONFIG_FILE).href);
let config = await mod.default;
if (typeof config === "function") config = await config({ command: process.env.MYPHP_CONFIG_COMMAND });
if (typeof config !== "object" || config === null || Array.isArray(config)) {
  throw new Error("the default export is not a configuration object, or a function returning one");
}
writeFileSync(process.env.MYPHP_CONFIG_OUT, JSON.stringify(config));
JS;

/** The myphp command running, which a configuration exporting a function gets. */
$GLOBALS['running'] = '';

/**
 * The configuration of the project in $dir as JSON, and the file it comes
 * from (mygo's readConfig): myphp.json, or myphp.config.ts, which a
 * JavaScript runtime evaluates; without either, null and myphp.json.
 *
 * @return array{?string, string}
 */
function readConfig(string $dir): array
{
    $json = is_file("$dir/" . CONFIG); $ts = is_file("$dir/" . CONFIG_TS);
    $json && $ts && fail(CONFIG . ' configures the project too; keep one of them');
    if ($ts) {
        return [evalTSConfig($dir, "$dir/" . CONFIG_TS), CONFIG_TS];
    }
    return [$json ? (string)file_get_contents("$dir/" . CONFIG) : null, CONFIG];
}

/**
 * Evaluates myphp.config.ts with Bun, or Node.js 22.6 and later, which strip
 * the types (mygo's evalTSConfig): a loader read from the runtime's standard
 * input imports the file, awaits its default export, calls it with the
 * command when it is a function, and writes the configuration as JSON, which
 * then goes through the checks of myphp.json.
 */
function evalTSConfig(string $dir, string $file): string
{
    $cmd = null;
    if (($bun = Cmd::look('bun')) !== '') {
        $cmd = [$bun, 'run', '-'];
    } elseif (($node = Cmd::look('node')) !== '' && ($flags = nodeTypeScriptFlags($node)) !== null) {
        $cmd = [$node, ...$flags, '--input-type=module', '-'];
    }
    $cmd !== null || fail('evaluating ' . CONFIG_TS . ' needs Bun (https://bun.sh) or Node.js 22.6 or later');
    $out = tempnam(sys_get_temp_dir(), 'myphp-config-');
    try {
        $env = ['MYPHP_CONFIG_FILE' => $file, 'MYPHP_CONFIG_OUT' => $out, 'MYPHP_CONFIG_COMMAND' => $GLOBALS['running']] + getenv();
        $p = proc_open($cmd, [0 => ['pipe', 'r'], 1 => ['file', 'php://stderr', 'w'], 2 => ['pipe', 'w']], $pipes, $dir, $env); // what it prints does not mix with myphp's output
        fwrite($pipes[0], CONFIG_LOADER);
        fclose($pipes[0]);
        $err = trim((string)stream_get_contents($pipes[2]));
        fclose($pipes[2]);
        if (proc_close($p) !== 0) {
            fail(CONFIG_TS . ': ' . ($err !== '' ? $err : basename($cmd[0]) . ' failed'));
        }
        $data = (string)file_get_contents($out);
        $data !== '' || fail(CONFIG_TS . ': ' . basename($cmd[0]) . ' exited without writing the configuration');
        return $data;
    } finally {
        @unlink($out);
    }
}

/** The flags that make the Node.js at $node run TypeScript, or null when it is too old to. @return ?list<string> */
function nodeTypeScriptFlags(string $node): ?array
{
    $v = explode('.', ltrim(trim((string)shell_exec(escapeshellarg($node) . ' --version')), 'v'));
    [$major, $minor] = [(int)($v[0] ?? 0), (int)($v[1] ?? 0)];
    return match (true) {
        $major >= 24, $major === 23 && $minor >= 6, $major === 22 && $minor >= 18 => ['--no-warnings'], // types are stripped by default
        $major === 23, $major === 22 && $minor >= 6 => ['--no-warnings', '--experimental-strip-types'],
        default => null,
    };
}

/**
 * The project of the directory in $args and its configuration, myphp.json
 * or myphp.config.ts,
 * with mygo's defaults and checks (mygo's loadConfig): every field is
 * optional. name (default: the directory's), identifier (com.myphp.<name>),
 * slug (lower-case letters, digits and hyphens: the name of the update
 * archives, default the name's, Native\Build\Slug), version (0.1.0), copyright, icon (a square PNG, default
 * resources/icon.png), entry (the PHP file the app runs, default app.php),
 * out (default dist), resources, urlSchemes, fileAssociations, i18n,
 * updates, devUrl, devCommand, buildCommand, frontendDist, bindings,
 * framework, and macos: icon (an Assets.car, an Icon Composer .icon or an .icns),
 * minimumSystemVersion (12.0), signingIdentity ("-", ad hoc),
 * entitlements, provisioningProfile (embedded before signing),
 * helperEntitlements, infoPlist, dmgTitle (the name) and notarize
 * ({"keychainProfile": …, "keychain": …}); linux (mygo's): maintainer
 * (package.json's author, else the name), comment, categories, depends,
 * webview (a bool, else whether the app shows pages, Linux::usesPages) and
 * command (a name or a list of them, kept as a list).
 *
 * @return array{dir: string, config: array}
 */
function project(array $args): array
{
    $dir = realpath($args[0] ?? '.') ?: fail(($args[0] ?? '.') . ' does not exist');
    is_dir($dir) || fail("$dir is not a directory");
    [$data, $name] = readConfig($dir);
    $c = [];
    if ($data !== null) {
        try {
            $c = json_decode($data, true, 32, JSON_THROW_ON_ERROR);
        } catch (JsonException $e) {
            fail("$name: " . $e->getMessage());
        }
        is_array($c) && ($c === [] || !array_is_list($c)) || fail("$name is not an object");
    }
    $c['configFile'] = $name; // for messages, as mygo's configName
    $bad = fn(string $msg): never => fail("$name: $msg");
    $c['name'] = orElse((string)($c['name'] ?? ''), basename($dir));
    $c['slug'] ??= '';
    is_string($c['slug']) && ($c['slug'] === '' || preg_match(Slug::PATTERN, $c['slug']) === 1) || $bad('slug ' . json_encode($c['slug']) . ' is not a slug (lower-case letters and digits, with single hyphens between them)');
    if (($c['identifier'] ?? '') === '') {
        $c['identifier'] = 'com.myphp.' . orElse(strtolower((string)preg_replace('/[^a-zA-Z0-9]+/', '', $c['name'])), 'app');
    }
    $c['version'] = orElse((string)($c['version'] ?? ''), '0.1.0');
    $c['entry'] = orElse((string)($c['entry'] ?? ''), 'app.php');
    $c['out'] = orElse((string)($c['out'] ?? ''), 'dist');
    if (($c['icon'] ?? '') === '' && is_file("$dir/resources/icon.png")) {
        $c['icon'] = 'resources/icon.png';
    }
    $m = $c['macos'] ?? [];
    is_array($m) && ($m === [] || !array_is_list($m)) || $bad('macos is an object');
    $m['minimumSystemVersion'] = orElse((string)($m['minimumSystemVersion'] ?? ''), '12.0');
    $m['signingIdentity'] = orElse((string)($m['signingIdentity'] ?? ''), '-');
    $m['dmgTitle'] = orElse((string)($m['dmgTitle'] ?? ''), $c['name']);
    $m['provisioningProfile'] ??= '';
    is_string($m['provisioningProfile']) || $bad('macos.provisioningProfile is the path of a provisioning profile');
    $m['infoPlist'] ??= [];
    is_array($m['infoPlist']) && ($m['infoPlist'] === [] || !array_is_list($m['infoPlist'])) || $bad('macos.infoPlist is an object of Info.plist keys');
    $m['helperEntitlements'] ??= [];
    is_array($m['helperEntitlements']) || $bad('macos.helperEntitlements is an object');
    foreach ($m['helperEntitlements'] as $name => $ent) {
        $name !== '' && is_string($ent) && $ent !== '' || $bad('macos.helperEntitlements maps the path of code among the resources to a property list of entitlements, not ' . json_encode((string)$name) . ' to ' . json_encode($ent));
    }
    if (isset($m['notarize'])) {
        is_array($m['notarize']) && is_string($m['notarize']['keychainProfile'] ?? null) && $m['notarize']['keychainProfile'] !== '' || $bad('macos.notarize needs a keychainProfile (see xcrun notarytool store-credentials)');
        $m['notarize'] = ['keychainProfile' => $m['notarize']['keychainProfile'], 'keychain' => (string)($m['notarize']['keychain'] ?? '')];
    }
    if (($m['icon'] ?? '') !== '' && !in_array(strtolower(pathinfo($m['icon'], PATHINFO_EXTENSION)), ['car', 'icon', 'icns'], true)) {
        $bad("macos.icon {$m['icon']} is an Assets.car, an Icon Composer .icon or an .icns");
    }
    $c['macos'] = $m;
    $l = $c['linux'] ?? [];
    is_array($l) && ($l === [] || !array_is_list($l)) || $bad('linux is an object');
    $l['maintainer'] = orElse(orElse(trim((string)($l['maintainer'] ?? '')), packageAuthor($dir)), $c['name']);
    $l['comment'] = (string)($l['comment'] ?? '');
    foreach (['categories', 'depends'] as $k) {
        $l[$k] ??= [];
        is_array($l[$k]) && array_is_list($l[$k]) && array_filter($l[$k], fn($v) => !is_string($v) || $v === '') === [] || $bad("linux.$k is a list of names");
    }
    !isset($l['webview']) || is_bool($l['webview']) || $bad('linux.webview is true or false');
    try {
        $l['command'] = Linux::commands($l['command'] ?? null);
    } catch (RuntimeException $e) {
        $bad($e->getMessage());
    }
    $c['linux'] = $l;
    $c['resources'] ??= [];
    is_array($c['resources']) && array_is_list($c['resources']) || $bad('resources is a list of files and directories');
    foreach ($c['urlSchemes'] ?? [] as $scheme) {
        is_string($scheme) && preg_match('/^[a-zA-Z][a-zA-Z0-9+.-]*$/', $scheme) === 1 || $bad('urlSchemes: ' . json_encode($scheme) . ' is not a URL scheme (a letter, then letters, digits, +, - or .)');
    }
    foreach ($c['fileAssociations'] ?? [] as $i => $fa) {
        ($fa['ext'] ?? []) !== [] || $bad("fileAssociations[$i] has no ext");
        foreach ($fa['ext'] as $ext) {
            is_string($ext) && preg_match('/^[a-zA-Z0-9][a-zA-Z0-9_+-]*$/', $ext) === 1 || $bad("fileAssociations[$i]: " . json_encode($ext) . ' is not a file name extension (without the dot)');
        }
        in_array($fa['role'] ?? 'Editor', ['Editor', 'Viewer'], true) || $bad("fileAssociations[$i].role is Editor or Viewer");
    }
    if (($c['devUrl'] ?? '') !== '') {
        preg_match('~^https?://[^/]+~', $c['devUrl']) === 1 || $bad('devUrl ' . json_encode($c['devUrl']) . ' is not an http(s) URL');
    }
    if (isset($c['updates'])) {
        try {
            new MyPHP\Native\Update\Publish($dir, $c);
        } catch (RuntimeException $e) {
            $bad($e->getMessage());
        }
    }
    return ['dir' => $dir, 'config' => $c];
}

/** The author of the project's package.json, "Name <email>", or '' (mygo's packageAuthor). */
function packageAuthor(string $dir): string
{
    $data = @file_get_contents("$dir/package.json");
    $author = $data === false ? null : (json_decode($data, true)['author'] ?? null);
    [$name, $email] = ['', ''];
    if (is_string($author)) {
        $name = explode('(', $author)[0];
        [$name, $email] = array_pad(explode('<', $name, 2), 2, '');
        $email = explode('>', $email)[0];
    } elseif (is_array($author)) {
        [$name, $email] = [(string)($author['name'] ?? ''), (string)($author['email'] ?? '')];
    }
    $name = implode(' ', preg_split('/\s+/', trim($name), -1, PREG_SPLIT_NO_EMPTY)); $email = trim($email);
    return $name === '' ? '' : ($email === '' ? $name : "$name <$email>");
}

function sh(array $cmd, ?string $cwd = null): int
{
    $p = proc_open($cmd, [0 => ['file', 'php://stdin', 'r'], 1 => ['file', 'php://stdout', 'w'], 2 => ['file', 'php://stderr', 'w']], $pipes, $cwd);
    return proc_close($p);
}

// ---- init ---------------------------------------------------------------
const INIT_USAGE = <<<'TXT'
init [flags] <dir>

Creates a new MyPHP project. The native template shows a user interface
MyPHP draws itself, written in PHP with MyPHP\UI. The web template has a
TypeScript frontend built with Vite: Bun installs its dependencies, the
myphp-cli and myphp-runtime packages of this checkout among them, and runs
its scripts, bun run dev and bun run build. Both get the app's icon,
resources/icon.png, and the bundled agent skills.

Flags:
  -name name            application name (default: directory name)
  -template native|web  the project (default native)
TXT;

function init(array $args): void
{
    help($args, INIT_USAGE);
    $template = option($args, 'template', 'native');
    $name = option($args, 'name', '');
    count($args) === 1 || fail("missing project directory\n\nUsage: myphp " . INIT_USAGE);
    in_array($template, ['native', 'web'], true) || fail("unknown template \"$template\": native or web");
    $dir = $args[0];
    !is_dir($dir) || count(scandir($dir)) === 2 || fail("$dir is not empty");
    is_dir($dir) || mkdir($dir, 0755, true) || fail("cannot create $dir");
    $dir = realpath($dir);
    $name = $name !== '' ? $name : basename($dir);
    $data = ['name' => $name, 'slug' => Slug::of($name), 'identifier' => 'com.example.' . str_replace('-', '', Slug::of($name)), 'framework' => realpath(FRAMEWORK),
        'runtime' => 'file:' . realpath(FRAMEWORK) . '/packages/runtime', 'cli' => 'file:' . realpath(FRAMEWORK) . '/packages/cli'];
    logf("Creating $dir");
    writeTemplate(TEMPLATES . "/$template", $dir, $data);
    mkdir("$dir/resources");
    file_put_contents("$dir/resources/icon.png", Icns::defaultIcon());
    writeSkills($dir);
    $rel = str_starts_with($dir, getcwd() . '/') ? substr($dir, strlen(getcwd()) + 1) : $dir;
    if ($template === 'native') {
        echo "\nCreated $name. Next steps:\n\n  cd $rel\n  myphp dev      # develop with live reload\n  myphp build    # package the app\n\n";
        return;
    }
    if (Cmd::look('bun') === '') {
        warnf('Bun not found: install it from https://bun.sh, then run bun install');
    } else {
        logf('Installing the dependencies');
        sh(['bun', 'install'], $dir) === 0 || fail('bun install failed');
        logf('Installed the dependencies');
        try {
            generateBindings($dir, project([$dir])['config']);
        } catch (Failure $e) {
            warnf("{$e->getMessage()}; run myphp generate once it can be read");
        }
    }
    echo "\nCreated $name. Next steps:\n\n  cd $rel\n  bun run dev      # develop with live reload\n  bun run build    # package the app\n\n";
}

/** The templates of myphp init (mygo's template): native UI, and a TypeScript frontend built with Vite. */
const TEMPLATES = __DIR__ . '/template';

/**
 * Writes the template $from into $dir: <name>.tmpl files with their values
 * filled in, as {{json:name}}, {{php:name}} and {{html:name}} quote them,
 * "gitignore" as .gitignore, the others as they are.
 *
 * @param array<string, string> $data
 */
function writeTemplate(string $from, string $dir, array $data): void
{
    $files = new RecursiveIteratorIterator(new RecursiveDirectoryIterator($from, FilesystemIterator::SKIP_DOTS));
    foreach ($files as $f) {
        $rel = substr($f->getPathname(), strlen($from) + 1);
        $text = (string)file_get_contents($f->getPathname());
        if (str_ends_with($rel, '.tmpl')) {
            $rel = substr($rel, 0, -5);
            $text = (string)preg_replace_callback('/\{\{(json|php|html):(\w+)\}\}/', fn(array $m): string => match ($m[1]) {
                'json' => json_encode($data[$m[2]], JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE),
                'php' => var_export($data[$m[2]], true),
                'html' => htmlspecialchars($data[$m[2]]),
            }, $text);
        }
        if ($rel === 'gitignore') {
            $rel = '.gitignore';
        }
        @mkdir(dirname("$dir/$rel"), 0755, true);
        file_put_contents("$dir/$rel", $text) !== false || fail("cannot write $dir/$rel");
    }
}

// ---- dev ----------------------------------------------------------------
/** Writes the TypeScript client of the bound PHP services (bindings), running the entry with MYPHP_GENERATE, which App::run() answers; reports whether it changed. */
function generateBindings(string $dir, array $config): bool
{
    if (($config['bindings'] ?? '') === '') {
        return false;
    }
    $out = path($dir, $config['bindings']);
    @mkdir(dirname($out), 0755, true);
    $before = is_file($out) ? file_get_contents($out) : null;
    $p = proc_open([PHP_BINARY, ...PHP_FLAGS, path($dir, $config['entry'])], [0 => ['file', '/dev/null', 'r'], 1 => ['file', 'php://stdout', 'w'], 2 => ['file', 'php://stderr', 'w']], $pipes, $dir, ['MYPHP_GENERATE' => $out, 'MYPHP_HOME' => frameworkOf($config)] + getenv());
    $code = proc_close($p);
    $code === 0 && is_file($out) || fail("generating {$config['bindings']}: {$config['entry']} exited with $code");
    if (file_get_contents($out) === $before) {
        return false;
    }
    logf("Wrote {$config['bindings']}");
    return true;
}

const DEV_USAGE = <<<'TXT'
dev [flags] [dir]

Develops the app with live reload. It writes the TypeScript client of a
frontend, runs devCommand from myphp.json (such as a Vite dev server),
waits for devUrl to answer, then builds a development app, which loads
devUrl in place of its built frontend, and launches it. Without devUrl,
the app serves frontendDist from disk. The development app is "<name> Dev"
with the identifier "<identifier>.dev", in .myphp/dev: a real bundle, with
the app's icon and resources, whose launcher runs the project's files.

Changes to the PHP files, myphp.json, the icon, the resources or the
catalogs of messages rebuild the app, regenerate the TypeScript client and
the accessors of the catalogs, and relaunch it. A build that fails keeps the
previous one running; the next change tries again. Frontend changes are
left to the dev server. Quitting the app ends myphp dev.

On a terminal, type r and Enter to rebuild and restart the app, c to clear
the console, q to quit, h for help.

With -lang, the app runs in that language, a BCP 47 tag such as de or
zh-Hant, or a pseudo locale: en-XA (accented and longer text) or ar-XB
(right to left), which test layouts without translations. It does not
keep it: the app's own setting is left as it is.

Flags:
  -lang tag           run the app in this language, without keeping it
  -sign identity      signing identity for the development app (default "-")
  -skip-dev-command   do not run devCommand
TXT;

/** The exit code of an app that App::relaunch() asks myphp dev to start again (mygo's devRelaunchCode). */
const DEV_RELAUNCH_CODE = 75;

/** The development app: "<name> Dev" with the identifier "<identifier>.dev", so that its data, preferences and single instance lock stay apart from the production app's (mygo's devConfig). */
function devConfig(array $c): array
{
    $c['name'] .= ' Dev';
    if (($c['slug'] ?? '') !== '') { $c['slug'] .= '-dev'; }
    $c['identifier'] .= '.dev';
    return $c;
}

/** $paths that changed, for the line of a build (mygo's changeSummary). @param list<string> $paths */
function changeSummary(string $root, array $paths): string
{
    $names = array_map(fn(string $p) => str_starts_with($p, "$root/") ? substr($p, strlen($root) + 1) : $p, array_slice($paths, 0, 3));
    $n = count($paths);
    return match (true) {
        $n > 3 => implode(', ', $names) . ' and ' . ($n - 3) . ' more changed',
        $n > 1 => implode(', ', array_slice($names, 0, -1)) . ' and ' . $names[$n - 1] . ' changed',
        $n === 1 => "{$names[0]} changed",
        default => 'files changed',
    };
}

/**
 * What a development build is made of, by path: its modification time and
 * size, polled for changes (mygo's listBuildInputs and watcher): the
 * project's PHP files and the framework's, myphp.json, the icon, the
 * entitlements, the resources and the catalogs of messages; not the
 * accessors and the client written from them, the output, the hidden
 * directories or the frontend, which is the dev server's.
 *
 * @return array<string, string>
 */
function devInputs(string $dir, array $c): array
{
    $skip = [path($dir, $c['out']), "$dir/vendor", "$dir/node_modules", "$dir/myphp"];
    if (($c['frontendDist'] ?? '') !== '') {
        $skip[] = rtrim(path($dir, $c['frontendDist']), '/');
    }
    $generated = [];
    if (($c['bindings'] ?? '') !== '') {
        $generated[] = path($dir, $c['bindings']);
    }
    $i18n = i18nConfig($dir, $c);
    if ($i18n !== null) {
        $generated[] = "{$i18n['path']}/" . MyPHP\Native\I18nGen::className($i18n['path']) . '.php';
        if (($c['bindings'] ?? '') !== '') {
            $generated[] = dirname(path($dir, $c['bindings'])) . '/' . basename($i18n['path']) . '.ts';
        }
    }
    $out = [];
    $add = function (string $p) use (&$out): void {
        $st = @stat($p);
        if ($st !== false) {
            $out[$p] = "{$st['mtime']}:{$st['size']}";
        }
    };
    $walk = function (string $root, ?string $ext) use (&$walk, $add, $skip, $generated): void {
        foreach (@scandir($root) ?: [] as $name) {
            $p = "$root/$name";
            if ($name === '.' || $name === '..' || $name[0] === '.' || in_array($p, $skip, true) || in_array($p, $generated, true)) {
                continue;
            }
            if (is_dir($p)) {
                $walk($p, $ext);
            } elseif ($ext === null || str_ends_with($name, $ext)) {
                $add($p);
            }
        }
    };
    $walk($dir, '.php');
    $walk(frameworkOf($c) . '/src', '.php');
    $walk("$dir/" . Resources::DIR, null);
    foreach ($c['resources'] as $r) {
        is_dir(path($dir, $r)) ? $walk(path($dir, $r), null) : $add(path($dir, $r));
    }
    if ($i18n !== null) {
        $walk($i18n['path'], '.json');
    }
    foreach (array_filter([CONFIG, CONFIG_TS, $c['icon'] ?? '', $c['macos']['entitlements'] ?? '', $c['macos']['provisioningProfile'], ...array_values($c['macos']['helperEntitlements'])]) as $f) {
        $add(path($dir, $f));
    }
    ksort($out, SORT_STRING);
    return $out;
}

/**
 * A development session (mygo's devSession): it builds the development
 * app in .myphp/dev/darwin-<arch>, launches it with MYPHP_DEV=1 and its
 * environment, and builds and launches it again as what it is made of
 * changes.
 */
final class DevSession
{
    /** @var resource|null the running app */
    public $app = null;
    public string $exe = '';
    /** The fingerprint of the running build. */
    public string $sum = '';
    private string $iconKey = '';
    private ?string $icns = null;

    /** @param array<string, string> $env */
    public function __construct(public readonly string $root, public readonly string $sign, public readonly string $name, private readonly array $env) {}

    /**
     * Builds the app and launches it once it differs from the running
     * build, stopping that one first; returns false when nothing changed.
     */
    public function buildAndLaunch(): bool
    {
        ['config' => $c] = project([$this->root]);
        $dc = devConfig($c);
        $arch = hostArch();
        $dir = "{$this->root}/.myphp/dev/darwin-$arch";
        is_dir($dir) || mkdir($dir, 0755, true) || fail("cannot create $dir");
        generateI18n($this->root, $c);
        $framework = frameworkOf($c);
        try {
            $res = Resources::collect($this->root, $c['configFile'], $dc['resources'], 'darwin', $arch, natives($this->root, $framework, $arch), Resources::reserved(hasCatalog($dc)));
        } catch (RuntimeException $e) {
            fail($e->getMessage());
        }
        $icns = $this->icon($c);
        $name = orElse(Dmg::fsName($dc['name']), 'app');
        $plist = Bundle::xml(Bundle::infoPlist($dc, $name, $icns !== null, false, [], [], false));
        // Fingerprint what the app is made of, to skip relaunching when a change did not affect it.
        $h = hash_init('sha256');
        foreach (devInputs($this->root, $c) as $p => $_) {
            hash_update($h, "$p\0" . (is_file($p) ? hash_file('sha256', $p) : '') . "\0");
        }
        foreach ($res as $r) {
            if ($r['src'] === '') {
                hash_update($h, "{$r['name']}\0dir\0");
                continue;
            }
            Resources::walk($r['src'], $r['nested'], function (string $path, array $st) use ($h, $r): void {
                hash_update($h, "{$r['name']}\0" . substr($path, strlen($r['src'])) . "\0{$st['mode']}\0" . (($st['mode'] & 0170000) === 0040000 ? '' : "{$st['size']}\0{$st['mtime']}\0"));
            });
        }
        hash_update($h, ($icns ?? '') . $plist . PHP_BINARY);
        $sum = hash_final($h);
        if ($sum === $this->sum) {
            return false;
        }
        generateBindings($this->root, $c);
        $stage = "$dir/.staging-" . getmypid();
        sh(['rm', '-rf', $stage]);
        mkdir("$stage/$name.app/Contents/MacOS", 0755, true);
        try {
            $contents = "$stage/$name.app/Contents";
            mkdir("$contents/Resources");
            if ($icns !== null) {
                file_put_contents("$contents/Resources/" . Resources::ICON, $icns);
            }
            Resources::copy($res, "$contents/Resources");
            $plist = Bundle::xml(Bundle::infoPlist($dc, $name, $icns !== null, false, writeLocalizations($this->root, $dc, "$contents/Resources"), [], false));
            file_put_contents("$contents/Info.plist", $plist);
            file_put_contents("$contents/PkgInfo", 'APPL????');
            buildExecLauncher("$contents/MacOS/$name", $c['entry'], $arch, $this->root);
            $m = $dc['macos'];
            embedProfile($this->root, $m, $contents, $this->sign, false);
            Codesign::sign("$stage/$name.app", $this->sign, ($m['entitlements'] ?? '') !== '' ? path($this->root, $m['entitlements']) : '', array_map(fn(string $f) => path($this->root, $f), $m['helperEntitlements']), false, $c['configFile']);
            $final = "$dir/$name.app";
            replacePath("$stage/$name.app", $final);
        } catch (RuntimeException $e) {
            fail($e->getMessage());
        } finally {
            sh(['rm', '-rf', $stage]);
        }
        $this->stop();
        $this->launch("$final/Contents/MacOS/$name");
        $this->sum = $sum;
        return true;
    }

    /** The app icon as .icns, rendered only when it changed. */
    private function icon(array $c): ?string
    {
        if (($c['icon'] ?? '') === '') {
            return null;
        }
        $p = path($this->root, $c['icon']);
        $st = @stat($p) ?: fail("icon {$c['icon']}: cannot read it");
        $key = "$p:{$st['size']}:{$st['mtime']}";
        if ($key !== $this->iconKey) {
            [$this->iconKey, $this->icns] = [$key, appIcon($this->root, $c)];
        }
        return $this->icns;
    }

    /** Starts the build at $exe in the project, with MYPHP_DEV=1, which App::relaunch() asks to be started again. */
    public function launch(string $exe): void
    {
        $this->app = proc_open([$exe], [0 => ['file', '/dev/null', 'r'], 1 => ['file', 'php://stdout', 'w'], 2 => ['file', 'php://stderr', 'w']], $pipes, $this->root, $this->env + ['MYPHP_DEV' => '1'] + getenv());
        $this->app !== false || fail("cannot start $exe");
        $this->exe = $exe;
    }

    /** The exit code of the app when it exited, null while it runs or when none runs. */
    public function exited(): ?int
    {
        if ($this->app === null) {
            return null;
        }
        $s = proc_get_status($this->app);
        if ($s['running']) {
            return null;
        }
        proc_close($this->app);
        $this->app = null;
        return $s['exitcode'];
    }

    /** Asks the app to quit, like Quit (SIGTERM, which App takes as Quit), and kills it when it has not exited after 3 seconds. */
    public function stop(): void
    {
        if ($this->app === null) {
            return;
        }
        proc_terminate($this->app, 15);
        for ($end = microtime(true) + 3; proc_get_status($this->app)['running'] && microtime(true) < $end;) {
            usleep(20_000);
        }
        if (proc_get_status($this->app)['running']) {
            proc_terminate($this->app, 9);
        }
        proc_close($this->app);
        $this->app = null;
    }
}

function dev(array $args): void
{
    help($args, DEV_USAGE);
    $lang = option($args, 'lang', '');
    $sign = option($args, 'sign', '-');
    $skipDevCommand = flag($args, 'skip-dev-command');
    ['dir' => $dir, 'config' => $c] = project($args);
    $env = ['MYPHP_ENV' => 'development', 'MYPHP_HOME' => frameworkOf($c)];
    if ($lang !== '') { // the app reads it as it starts, over the language it keeps
        ($tag = MyPHP\I18n::normalize($lang)) !== '' || fail("-lang \"$lang\" is not a language: a BCP 47 tag, as de, zh-Hant or pt-BR, or a pseudo locale, en-XA or ar-XB");
        $env['MYPHP_LOCALE'] = $tag;
    }
    // The accessors of the catalogs and the TypeScript client come first: the app and the frontend import them.
    generateI18n($dir, $c);
    generateBindings($dir, $c);
    $server = null;
    if (($c['devCommand'] ?? '') !== '' && !$skipDevCommand) {
        logf('Starting the dev server');
        $server = proc_open(['/bin/sh', '-c', $c['devCommand']], [0 => ['file', '/dev/null', 'r'], 1 => ['file', 'php://stdout', 'w'], 2 => ['file', 'php://stderr', 'w']], $pipes, $dir);
        $server !== false || fail("cannot run {$c['devCommand']}");
        register_shutdown_function(fn() => proc_get_status($server)['running'] && proc_terminate($server, 15));
    }
    if (($c['devUrl'] ?? '') !== '') {
        waitForURL($c['devUrl'], $server);
        $env['MYPHP_DEV_URL'] = $c['devUrl'];
    } elseif ($server !== null) {
        logf("Started {$c['devCommand']}");
    }
    if (($c['devUrl'] ?? '') === '' && ($c['frontendDist'] ?? '') !== '') {
        $env['MYPHP_FRONTEND_DIST'] = path($dir, $c['frontendDist']); // served from disk
    }
    $s = new DevSession($dir, $sign, devConfig($c)['name'], $env);
    $keys = stream_isatty(STDIN);
    if ($keys) {
        stream_set_blocking(STDIN, false);
    }
    $serverExited = false;
    $build = function (string $title, string $verb, array $changed) use ($s, $dir): bool {
        $why = $changed !== [] ? ' (' . changeSummary($dir, $changed) . ')' : '';
        logf("$title {$s->name}$why");
        try {
            if ($s->buildAndLaunch()) {
                logf("$verb {$s->name}$why");
            } else {
                logf("No change to {$s->name}$why");
            }
            return true;
        } catch (Failure $e) {
            fwrite(STDERR, "myphp: ✗ {$e->getMessage()}\n");
            fwrite(STDERR, '  ' . ($s->app !== null ? 'The previous build keeps running: save a fix to try again.' : 'Save a fix to try again.') . "\n");
            return false;
        }
    };
    $build('Building', 'Built', []);
    echo "\n  → Watching for changes\n" . ($keys ? "  → press h + enter to show help\n" : '') . "\n";
    $seen = devInputs($dir, project([$dir])['config']);
    while (true) {
        usleep(250_000);
        if ($server !== null && !$serverExited && !proc_get_status($server)['running']) {
            $serverExited = true; // from now on, news
            warnf('The dev server exited');
        }
        $code = $s->exited();
        if ($code === DEV_RELAUNCH_CODE) { // App::relaunch(): start the same build again
            $s->launch($s->exe);
            logf("Relaunched {$s->name}");
        } elseif ($code === 0) {
            logf("{$s->name} quit");
            return;
        } elseif ($code !== null) {
            fwrite(STDERR, "myphp: ✗ {$s->name} exited (exit status $code)\n  Save a change to start it again.\n");
            $s->sum = '';
        }
        $restart = false;
        if ($keys && ($line = fgets(STDIN)) !== false) {
            switch (strtolower(trim($line))) {
                case 'r': $restart = true; break;
                case 'c': echo "\033[H\033[2J"; break;
                case 'q': $s->stop(); return;
                case 'h': echo "\n  Shortcuts\n  press r + enter to rebuild and restart the app\n  press c + enter to clear the console\n  press q + enter to quit\n\n"; break;
            }
        }
        try {
            $now = devInputs($dir, project([$dir])['config']);
        } catch (Failure $e) {
            $now = $seen; // myphp.json does not read: its next change tries again
            fwrite(STDERR, "myphp: ✗ {$e->getMessage()}\n");
        }
        if ($now === $seen && !$restart) {
            continue;
        }
        $changed = array_keys(array_diff_assoc($now, $seen) + array_diff_key($seen, $now));
        sort($changed);
        $seen = $now;
        if ($restart) {
            $s->sum = '';
            $build('Restarting', 'Restarted', []);
        } else {
            $build('Rebuilding', 'Rebuilt', $changed);
        }
    }
}

/** Waits up to 30 seconds for the server of $url to take connections, failing sooner when $server, its command, exits. */
function waitForURL(string $url, $server): void
{
    $u = parse_url($url);
    $host = trim($u['host'] ?? 'localhost', '[]');
    $port = $u['port'] ?? (($u['scheme'] ?? 'http') === 'https' ? 443 : 80);
    echo "myphp: waiting for the dev server at $url\n";
    for ($end = microtime(true) + 30; microtime(true) < $end; usleep(200_000)) {
        $sock = @fsockopen($host, $port, $errno, $errstr, 0.5);
        if ($sock !== false) {
            fclose($sock);
            echo "myphp: dev server ready at $url\n";
            return;
        }
        if ($server !== null && !proc_get_status($server)['running']) {
            fail('the dev server exited');
        }
    }
    fail("the dev server at $url did not answer in 30 seconds");
}

// ---- build --------------------------------------------------------------
const BUILD_USAGE = <<<'TXT'
build [flags] [dir]

Builds the production app for each platform. It runs buildCommand from
myphp.json, then makes <out>/darwin-<arch>/<name>.app: the app's PHP files
and the framework's, the frontendDist files, served at myphp://localhost/,
the contents of the resources directory and the resources listed in
myphp.json in Contents/Resources (resources/darwin, and resources/darwin-arm64
or resources/darwin-amd64, only ship with the apps for that platform;
darwin/universal combines darwin-arm64 and darwin-amd64), signed with
macos.signingIdentity (ad hoc by default), and "<name> <version> <arch>.dmg",
without the arch for darwin/universal, whose window invites dragging the app
to Applications. The programs among the resources are signed with the app.

For linux/amd64 and linux/arm64 it makes <out>/linux-<arch>: the launcher,
named after the slug, with the app's PHP files and the framework's in app/,
the frontend in frontend/, the resources (resources/linux, resources/linux-
<arch>), a desktop entry and the icon next to it; the app as
<slug>-<version>-linux-<arch>.tar.gz; a Debian package, which installs it in
/opt/<slug> with its desktop entry, its icons in the hicolor theme and, with
linux.command, its commands in /usr/bin; and a PKGBUILD, from which
makepkg -si packages the archive for Arch Linux and installs it. The
packages depend on GTK 3, libsecret, WebKitGTK when the app shows pages,
the app indicator when it has a tray icon, the PHP of the exec launcher
(php<version>-cli and the extensions MyPHP uses) and linux.depends.

Set macos.signingIdentity in myphp.json (or -sign) to a Developer ID to ship
outside the Mac App Store, and macos.notarize to notarize the disk image.

With updates in myphp.json and the key of myphp keygen in
MYPHP_UPDATER_PRIVATE_KEY, each platform also gets a signed update archive,
delta updates from the last versions published (updates.deltas), and
update-<platform>.json: publish them where updates point to, or with -upload.

Flags:
  -platform list        comma separated targets: darwin/arm64, darwin/amd64, darwin/universal, linux/amd64, linux/arm64 (default: this machine's)
  -launcher exec|micro  exec runs the PHP that built the app; micro makes one static binary (see myphp micro)
  -php version          the PHP version of micro.sfx, when myphp micro builds it
  -debug                keep development features such as the inspector
  -skip-build-command   do not run buildCommand
  -skip-dmg             do not create a disk image
  -skip-notarize        do not notarize even when macos.notarize is set
  -sign identity        signing identity (default: macos.signingIdentity, or "-" for ad hoc)
  -o dir                output directory (default: out from myphp.json, or dist)
  -upload               upload the disk images and updates to the GitHub release of this version (updates.github), as a draft, or to the bucket of updates.s3
TXT;

/** This machine's architecture, as the targets name it. */
function hostArch(): string
{
    return in_array(strtolower(php_uname('m')), ['arm64', 'aarch64'], true) ? 'arm64' : 'amd64';
}

function build(array $args): void
{
    help($args, BUILD_USAGE);
    $platforms = option($args, 'platform', (PHP_OS_FAMILY === 'Linux' ? 'linux/' : 'darwin/') . hostArch());
    $launcher = option($args, 'launcher', 'exec');
    $php = option($args, 'php');
    $sign = option($args, 'sign', '');
    $out = option($args, 'o', '');
    $opts = ['debug' => flag($args, 'debug'), 'skipDMG' => flag($args, 'skip-dmg'), 'skipNotarize' => flag($args, 'skip-notarize'), 'launcher' => $launcher];
    $skipBuildCommand = flag($args, 'skip-build-command');
    $upload = flag($args, 'upload');
    ['dir' => $dir, 'config' => $c] = project($args);
    if ($out !== '') {
        $c['out'] = $out;
    }
    in_array($launcher, ['exec', 'micro'], true) || fail('-launcher is exec or micro');
    $targets = [];
    foreach (array_filter(array_map('trim', explode(',', $platforms))) as $p) {
        [$os, $arch] = array_pad(explode('/', $p, 2), 2, '');
        $os === 'darwin' && in_array($arch, ['arm64', 'amd64', 'universal'], true) || $os === 'linux' && isset(Linux::DEB_ARCH[$arch])
            || fail("myphp builds macOS and Linux apps: the platform is darwin/arm64, darwin/amd64, darwin/universal, linux/amd64 or linux/arm64, not $p");
        $host = (PHP_OS_FAMILY === 'Linux' ? 'linux/' : 'darwin/') . hostArch();
        $launcher !== 'micro' || "$os/$arch" === $host || fail("-launcher micro builds for this machine, $host: micro.sfx is of its system and architecture");
        $targets[] = [$os, $arch];
    }
    $targets !== [] || fail('-platform names no platform');
    if ($upload) {
        try {
            Upload::check($c, $c['configFile']);
        } catch (RuntimeException $e) {
            fail($e->getMessage());
        }
    }
    $opts['sign'] = $sign !== '' ? $sign : $c['macos']['signingIdentity'];
    if (isset($c['macos']['notarize']) && !$opts['skipNotarize'] && $opts['sign'] === '-') {
        fail('notarization needs a Developer ID signing identity: set macos.signingIdentity or pass -sign');
    }
    if ($c['macos']['provisioningProfile'] !== '' && $opts['sign'] === '-' && in_array('darwin', array_column($targets, 0), true)) {
        fail(PROFILE_AD_HOC); // before building anything, as codesign would
    }
    // Check what the launcher needs before touching the output, so a failed build leaves the last one.
    if ($launcher === 'exec') {
        foreach ($targets as [$os, $arch]) {
            if ($os === 'darwin') {
                trim((string)shell_exec('command -v cc')) !== '' || fail('no C compiler for the launcher: xcode-select --install');
            } else {
                linuxCompiler($arch);
            }
        }
    } else {
        [, $opts['micro']] = ensureMicro($php);
    }
    $started = microtime(true);
    // The accessors of the catalogs come first, which the app calls, then the TypeScript client: the frontend build type-checks and bundles them.
    generateI18n($dir, $c);
    generateBindings($dir, $c);
    if (($c['buildCommand'] ?? '') !== '' && !$skipBuildCommand) {
        logf('Building the frontend');
        sh(['/bin/sh', '-c', $c['buildCommand']], $dir) === 0 || fail("{$c['buildCommand']} failed");
        logf('Built the frontend');
    }
    if (($c['frontendDist'] ?? '') !== '') {
        $dist = path($dir, $c['frontendDist']);
        is_dir($dist) || fail("frontendDist $dist does not exist; set buildCommand in myphp.json to build it");
        count(scandir($dist)) > 2 || fail("frontendDist $dist is empty");
        $out = rtrim(path($dir, $c['out']), '/') . '/';
        // The frontend is copied into the app being made under out: out inside it copied the copy into itself until the paths were too long.
        str_starts_with($out, rtrim($dist, '/') . '/') && fail("out {$c['out']} is inside frontendDist {$c['frontendDist']}, which the app copies: set out in myphp.json, as \"build\"");
    }
    $built = [];
    foreach ($targets as [$os, $arch]) {
        try {
            array_push($built, ...($os === 'linux' ? buildLinux($dir, $c, $arch, $opts) : buildPlatform($dir, $c, $arch, $opts)));
        } catch (RuntimeException $e) {
            fail($e->getMessage());
        }
    }
    echo buildSummary($dir, $c, $built, microtime(true) - $started);
    if ($upload) {
        try {
            Upload::publish($c, $c['version'], $built, publisher($dir, $c)?->notes() ?? '', 'myphp/' . VERSION, $c['configFile'], logf(...));
        } catch (RuntimeException $e) {
            fail($e->getMessage());
        }
    }
}

/** What a build made, by directory, with sizes (mygo's buildSummary). @param list<string> $artifacts */
function buildSummary(string $dir, array $c, array $artifacts, float $took): string
{
    $s = "\n  ✓ Built {$c['name']} {$c['version']} in " . ($took < 60 ? sprintf('%.1fs', $took) : sprintf('%dm%02ds', intdiv((int)$took, 60), (int)$took % 60)) . "\n";
    $width = max(array_map(fn($a) => mb_strlen(basename($a)), $artifacts ?: ['']));
    $shown = '';
    foreach ($artifacts as $a) {
        $d = (str_starts_with(dirname($a), "$dir/") ? substr(dirname($a), strlen($dir) + 1) : dirname($a)) . '/';
        if ($d !== $shown) {
            $shown = $d;
            $s .= "\n    $d\n";
        }
        $name = basename($a);
        $s .= "      $name" . str_repeat(' ', $width - mb_strlen($name)) . '  ' . sprintf('%9s', formatSize(bytesOf($a))) . "\n";
    }
    return $s;
}

function bytesOf(string $path): int
{
    if (!is_dir($path) || is_link($path)) {
        return is_file($path) ? (int)filesize($path) : 0;
    }
    $n = 0;
    foreach (new RecursiveIteratorIterator(new RecursiveDirectoryIterator($path, FilesystemIterator::SKIP_DOTS)) as $f) {
        if ($f->isFile() && !$f->isLink()) {
            $n += $f->getSize();
        }
    }
    return $n;
}

/** A number of bytes for messages (mygo's formatSize). */
function formatSize(int $n): string
{
    return $n < 1 << 20 ? sprintf('%d KB', ($n + (1 << 10) - 1) >> 10) : sprintf('%.1f MB', $n / (1 << 20));
}

/**
 * Builds and packages the app for darwin/$arch into <out>/darwin-$arch and
 * returns the artifacts (mygo's buildPlatform). Everything is prepared in a
 * staging directory that then replaces the platform directory, so a failed
 * build keeps the previous one and nothing stale remains.
 *
 * @return list<string>
 */
function buildPlatform(string $dir, array $c, string $arch, array $opts): array
{
    $out = path($dir, $c['out']);
    is_dir($out) || mkdir($out, 0755, true) || fail("cannot create $out");
    $stage = "$out/.staging-darwin-$arch-" . getmypid();
    mkdir($stage, 0755);
    try {
        $m = $c['macos'];
        $framework = frameworkOf($c);
        $res = Resources::collect($dir, $c['configFile'], $c['resources'], 'darwin', $arch, natives($dir, $framework, $arch), Resources::reserved(hasCatalog($c)));
        if (($other = Resources::otherArch($dir, 'darwin', $arch)) !== '') {
            warnf('No ' . Resources::DIR . "/darwin-$arch for darwin/$arch, though there is " . Resources::DIR . "/$other");
        }
        if (!$opts['debug'] && getenv('MYPHP_INSPECTOR') === '1') {
            logf('Keeping the inspector of native UI (MYPHP_INSPECTOR=1)');
        }
        $name = orElse(Dmg::fsName($c['name']), 'app');
        $app = "$stage/$name.app";
        $contents = "$app/Contents";
        foreach (["$contents/MacOS", "$contents/Resources/app/myphp"] as $d) {
            mkdir($d, 0755, true);
        }
        logf("Making darwin/$arch");
        // The app's files and the framework's src, as the bundle's Resources/app; its resources, its build output and its hidden files (.git, .agents, .myphp) stay out.
        $frontend = ($c['frontendDist'] ?? '') !== '' && !str_starts_with($c['frontendDist'], '/') ? [explode('/', ltrim($c['frontendDist'], './'))[0]] : []; // in Resources/frontend
        copyTree($dir, "$contents/Resources/app", [basename($out), 'vendor', 'node_modules', 'myphp', Resources::DIR, ...$frontend], false);
        copyTree("$framework/src", "$contents/Resources/app/myphp/src", []);
        // The frontend, served at myphp://localhost/ (mygo's embedded frontendDist).
        if (($c['frontendDist'] ?? '') !== '') {
            copyTree(path($dir, $c['frontendDist']), "$contents/Resources/frontend", ['.DS_Store']);
        }
        [$car, $carIcns] = appCatalog($dir, $c);
        $icns = $carIcns ?? ownIcns($dir, $c) ?? appIcon($dir, $c); // the .icon's own rendering for older macOS, or macos.icon's .icns
        if ($icns !== null) {
            file_put_contents("$contents/Resources/" . Resources::ICON, $icns);
        }
        if ($car !== null) {
            file_put_contents("$contents/Resources/" . Resources::CATALOG, $car);
        }
        Resources::copy($res, "$contents/Resources");
        $localizations = writeLocalizations($dir, $c, "$contents/Resources");
        file_put_contents("$contents/Info.plist", Bundle::xml(Bundle::infoPlist($c, $name, $icns !== null, $car !== null, $localizations, updatePlist($dir, $c, "darwin-$arch"), !$opts['debug'])));
        file_put_contents("$contents/PkgInfo", 'APPL????');
        if ($opts['launcher'] === 'exec') {
            buildExecLauncher("$contents/MacOS/$name", $c['entry'], $arch);
        } else {
            buildMicroLauncher("$contents/MacOS/$name", "$contents/Resources/app", $c['entry'], $opts['micro']);
        }
        $entitlements = ($m['entitlements'] ?? '') !== '' ? path($dir, $m['entitlements']) : '';
        $helpers = array_map(fn(string $f) => path($dir, $f), $m['helperEntitlements']);
        embedProfile($dir, $m, $contents, $opts['sign'], true);
        Codesign::sign($app, $opts['sign'], $entitlements, $helpers, !$opts['debug'], $c['configFile']);
        logf('Signed ' . basename($app) . ($opts['sign'] === '-' ? ' (ad hoc)' : ''));
        $artifacts = [$app];
        if (!$opts['skipDMG']) {
            $notarize = $opts['skipNotarize'] ? null : ($m['notarize'] ?? null);
            $artifacts[] = Dmg::build($app, $stage, $m['dmgTitle'], Dmg::fileName($c['name'], $c['version'], $arch), $opts['sign'], $notarize, logf(...));
        }
        array_push($artifacts, ...writeUpdate($dir, $c, $stage, basename($app), "darwin-$arch"));
        $final = "$out/darwin-$arch";
        replacePath($stage, $final);
        return array_map(fn(string $a) => "$final/" . basename($a), $artifacts);
    } finally {
        if (is_dir($stage)) {
            sh(['rm', '-rf', $stage]);
        }
    }
}

/**
 * Builds and packages the app for linux/$arch into <out>/linux-$arch and
 * returns the artifacts (mygo's buildPlatform for linux): the app as it is
 * installed, the launcher named after the slug with app/, frontend/,
 * info.json (Linux::info), the desktop entry, the icon, the MIME package
 * and the resources next to it, in a staging directory that replaces the
 * platform directory; then the Debian package, the archive and the
 * PKGBUILD of it.
 *
 * @return list<string>
 */
function buildLinux(string $dir, array $c, string $arch, array $opts): array
{
    $out = path($dir, $c['out']);
    is_dir($out) || mkdir($out, 0755, true) || fail("cannot create $out");
    $stage = "$out/.staging-linux-$arch-" . getmypid();
    mkdir($stage, 0755);
    try {
        $framework = frameworkOf($c);
        $slug = Slug::ofConfig($c);
        $res = Resources::collect($dir, $c['configFile'], $c['resources'], 'linux', $arch, natives($dir, $framework, $arch, 'linux'), Linux::reserved($slug));
        if (($other = Resources::otherArch($dir, 'linux', $arch)) !== '') {
            warnf('No ' . Resources::DIR . "/linux-$arch for linux/$arch, though there is " . Resources::DIR . "/$other");
        }
        if (!$opts['debug'] && getenv('MYPHP_INSPECTOR') === '1') {
            logf('Keeping the inspector of native UI (MYPHP_INSPECTOR=1)');
        }
        logf("Making linux/$arch");
        // The app's files and the framework's src, as app/; its resources, its build output and its hidden files stay out, as in the .app.
        $frontend = ($c['frontendDist'] ?? '') !== '' && !str_starts_with($c['frontendDist'], '/') ? [explode('/', ltrim($c['frontendDist'], './'))[0]] : [];
        copyTree($dir, "$stage/app", [basename($out), 'vendor', 'node_modules', 'myphp', Resources::DIR, ...$frontend], false);
        copyTree("$framework/src", "$stage/app/myphp/src", []);
        if (($c['frontendDist'] ?? '') !== '') {
            copyTree(path($dir, $c['frontendDist']), "$stage/frontend", ['.DS_Store']);
        }
        $php = '';
        if ($opts['launcher'] === 'exec') {
            $php = PHP_MAJOR_VERSION . '.' . PHP_MINOR_VERSION;
            $bin = (string)realpath(PHP_BINARY);
            if ($bin !== "/usr/bin/php$php") {
                warnf("The packages depend on php$php-cli, whose php is /usr/bin/php$php, but the launcher runs $bin, the php building the app");
            }
            buildLinuxExecLauncher("$stage/$slug", $bin, $c['entry'], $arch);
        } else {
            buildLinuxMicroLauncher("$stage/$slug", "$stage/app", $c['entry'], $opts['micro']);
        }
        file_put_contents("$stage/" . Linux::INFO, json_encode(Linux::info($c, $slug, !$opts['debug']), JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE) . "\n");
        // The desktop entry, the icon and the MIME package (mygo's writeLinuxDesktop), which the packages install where desktops look for them.
        $langs = linuxLanguages($dir, $c);
        $artifacts = ["$stage/$slug"];
        $png = null;
        if (($c['icon'] ?? '') !== '') {
            $png = @file_get_contents(path($dir, $c['icon']));
            $png !== false || fail("icon {$c['icon']}: cannot read it");
            file_put_contents("$stage/$slug.png", $png);
            $artifacts[] = "$stage/$slug.png";
        }
        if (($xml = Linux::mimePackage($c)) !== '') {
            file_put_contents("$stage/$slug.xml", $xml);
            $artifacts[] = "$stage/$slug.xml";
        }
        file_put_contents("$stage/$slug.desktop", Linux::desktopEntry($c, $slug, $png !== null ? $slug : '', $langs));
        $artifacts[] = "$stage/$slug.desktop";
        Resources::copy($res, $stage);
        // The app as installed: everything next to the launcher. Packages hold it.
        $installed = array_values(array_diff(scandir($stage) ?: [], ['.', '..']));
        try {
            $icons = $png === null ? [] : Linux::icons($png);
        } catch (RuntimeException $e) {
            fail("icon {$c['icon']}: {$e->getMessage()}");
        }
        $sources = appSources($dir, $c);
        $depends = Linux::debDepends($c['linux'], Linux::usesPages($c, $sources), Linux::usesTray($sources), Linux::usesSymbols($sources), $php);
        $artifacts[] = Deb::write($c, $stage, $slug, $arch, $installed, $depends, $icons, $langs);
        logf('Packaged ' . basename(end($artifacts)));
        // The app's archive, which the PKGBUILD packages (mygo's writeArchive, without updates).
        $archive = "$stage/$slug-{$c['version']}-linux-$arch.tar.gz";
        MyPHP\Native\Update\Archive::write($archive, $stage, $installed);
        $artifacts[] = $archive;
        array_push($artifacts, ...Pkgbuild::write($dir, $c, $stage, $slug, $arch, $installed, $archive, $depends, $icons, $langs, warnf(...)));
        if (isset($c['updates'])) {
            warnf("Not writing an update for linux/$arch: Linux apps do not update themselves yet");
        }
        $final = "$out/linux-$arch";
        replacePath($stage, $final);
        $top = count(array_filter($res, fn(array $r) => !str_contains($r['name'], '/')));
        if ($top > 0) {
            logf("Copied $top resources next to the launcher");
        }
        return array_map(fn(string $a) => "$final/" . basename($a), $artifacts);
    } finally {
        if (is_dir($stage)) {
            sh(['rm', '-rf', $stage]);
        }
    }
}

/** The app's PHP, as one string, which says what it uses (natives, Linux::usesPages). */
function appSources(string $dir, array $c): string
{
    $sources = '';
    foreach (phpFiles($dir, [basename(path($dir, $c['out'])), 'dist', 'vendor', 'node_modules', '.git', 'myphp']) as $f) {
        $sources .= file_get_contents($f) . "\n";
    }
    return $sources;
}

/** The languages of the app's catalogs, the source first, with its name and description in each (myphp.appName, myphp.appDescription), for the desktop entry (mygo's languages). @return list<array{0: string, 1: string, 2: string}> */
function linuxLanguages(string $dir, array $c): array
{
    if (($i = i18nConfig($dir, $c)) === null) {
        return [];
    }
    $files = glob("{$i['path']}/*.json") ?: [];
    sort($files, SORT_STRING);
    $langs = [];
    foreach ($files as $f) {
        $catalog = json_decode((string)file_get_contents($f), true);
        is_array($catalog) || fail("$f is not a catalog");
        $name = $catalog['myphp.appName'] ?? ''; $description = $catalog['myphp.appDescription'] ?? '';
        is_string($name) && is_string($description) && !preg_match('/[\r\n]/', $name . $description) || fail("$f: the app's name and description are strings that do not break the line");
        $l = [basename($f, '.json'), $name, $description];
        $l[0] === $i['source'] ? array_unshift($langs, $l) : $langs[] = $l;
    }
    return $langs;
}

/** The C compiler that makes the launcher of linux/$arch: cc for this machine's, else the GNU cross compiler of $arch (Linux::TRIPLE). */
function linuxCompiler(string $arch): string
{
    PHP_OS_FAMILY === 'Linux' || fail("-launcher exec runs the php that builds the app: build linux/$arch on Linux");
    if ($arch === hostArch()) {
        Cmd::look('cc') !== '' || fail('no C compiler for the launcher: install gcc (Debian, Ubuntu: apt install gcc)');
        return 'cc';
    }
    $cc = Linux::TRIPLE[$arch] . '-gcc';
    Cmd::look($cc) !== '' || fail("no C compiler for the launcher of linux/$arch: install $cc (Debian, Ubuntu: apt install gcc-" . Linux::TRIPLE[$arch] . ')');
    return $cc;
}

/** The exec launcher of a Linux app (Linux::launcherSource), running the php at $php, compiled for $arch. */
function buildLinuxExecLauncher(string $out, string $php, string $entry, string $arch): void
{
    $tmp = tempnam(sys_get_temp_dir(), 'myphp');
    $cFile = "$tmp.c";
    rename($tmp, $cFile);
    file_put_contents($cFile, Linux::launcherSource($php, PHP_FLAGS, $entry));
    $code = sh([linuxCompiler($arch), '-O2', '-Wall', '-o', $out, $cFile]);
    unlink($cFile);
    $code === 0 || fail('compiling the launcher failed');
}

/** The Linux app's launcher as one static binary: micro.sfx, then the INI the app needs and the app as a phar, which phpmicro reads after itself. */
function buildLinuxMicroLauncher(string $out, string $appDir, string $entry, string $micro): void
{
    $sfx = @file_get_contents($micro);
    $sfx !== false || fail("cannot read $micro");
    file_put_contents($out, $sfx . MachO::microPayload(implode("\n", MICRO_INI), appPhar($appDir, $entry))) !== false || fail("cannot write $out");
    chmod($out, 0755);
}

/** Moves $src to $dst, replacing what $dst held; the old one is renamed away before it is removed, so a running app keeps its files (mygo's replacePath). */
function replacePath(string $src, string $dst): void
{
    $old = '';
    if (file_exists($dst) || is_link($dst)) {
        $old = dirname($dst) . '/.old-' . getmypid() . '-' . basename($dst);
        sh(['rm', '-rf', $old]);
        rename($dst, $old) || fail("cannot move $dst away");
    }
    if (!rename($src, $dst)) {
        if ($old !== '') {
            rename($old, $dst);
        }
        fail("cannot move the build to $dst");
    }
    if ($old !== '') {
        sh(['rm', '-rf', $old]);
    }
}

/** Whether macos.icon is an asset catalog, an Assets.car or an Icon Composer .icon, rather than none or an .icns. */
function hasCatalog(array $c): bool
{
    $src = (string)($c['macos']['icon'] ?? '');
    return $src !== '' && strtolower(pathinfo($src, PATHINFO_EXTENSION)) !== 'icns';
}

/**
 * macos.icon when it is an .icns, which the app gets in place of the one
 * rendered from icon, for an icon drawn per size (a closer crop at 16 and
 * 32 points, made with iconutil from an .iconset); null otherwise (mygo's
 * bundleICNS). `myphp dev` still shows icon's.
 */
function ownIcns(string $dir, array $c): ?string
{
    $src = (string)($c['macos']['icon'] ?? '');
    if ($src === '' || hasCatalog($c)) {
        return null;
    }
    $data = @file_get_contents(path($dir, $src));
    if ($data === false) { fail("macos.icon $src: cannot read it"); }
    str_starts_with($data, 'icns') || fail("macos.icon $src: not an .icns file");
    return $data;
}

/** The configured icon (a PNG) as .icns, or null without one (mygo's appIcon). */
function appIcon(string $dir, array $c): ?string
{
    if (($c['icon'] ?? '') === '') {
        return null;
    }
    $src = @file_get_contents(path($dir, $c['icon']));
    $src !== false || fail("icon {$c['icon']}: cannot read it");
    try {
        return Icns::fromPng($src);
    } catch (RuntimeException $e) {
        fail("icon {$c['icon']}: {$e->getMessage()}");
    }
}

/**
 * The asset catalog of macos.icon and the .icns actool rendered from the
 * same icon, or nulls without one (mygo's appCatalog): an Assets.car as it
 * is, or an Icon Composer .icon compiled with actool, which needs Xcode 26
 * or later; one that cannot be compiled leaves the app with its .icns.
 *
 * @return array{?string, ?string}
 */
function appCatalog(string $dir, array $c): array
{
    $src = (string)($c['macos']['icon'] ?? '');
    if (!hasCatalog($c)) {
        return [null, null]; // an .icns is no catalog: ownIcns takes it
    }
    $path = path($dir, $src);
    if (strtolower(pathinfo($src, PATHINFO_EXTENSION)) !== 'icon') {
        $car = @file_get_contents($path);
        return [$car !== false ? $car : fail("macos.icon $src: cannot read it"), null];
    }
    is_dir($path) || fail("macos.icon $src is not an Icon Composer document, which is a directory");
    $work = sys_get_temp_dir() . '/myphp-actool-' . getmypid();
    try {
        // actool names the app icon after the document, which is AppIcon.icon in the catalog of every app.
        mkdir("$work/out", 0755, true);
        sh(['cp', '-R', $path, "$work/" . Resources::ICON_NAME . '.icon']);
        [, $msg] = MyPHP\Native\Build\Cmd::output(['xcrun', 'actool', "$work/" . Resources::ICON_NAME . '.icon', '--compile', "$work/out", '--output-format', 'human-readable-text',
            '--platform', 'macosx', '--target-device', 'mac', '--minimum-deployment-target', $c['macos']['minimumSystemVersion'],
            '--app-icon', Resources::ICON_NAME, '--output-partial-info-plist', "$work/out/partial.plist"]);
        $car = @file_get_contents("$work/out/" . Resources::CATALOG);
        $icns = @file_get_contents("$work/out/" . Resources::ICON_NAME . '.icns');
        if ($car === false || $icns === false) {
            warnf("Skipping $src: actool could not compile it (it needs Xcode 26 or later)\n" . trim($msg));
            return [null, null];
        }
        logf('Compiled ' . basename($src));
        return [$car, $icns];
    } finally {
        sh(['rm', '-rf', $work]);
    }
}

/**
 * The native libraries that the plugins the app uses name in their
 * mygo-plugin.json (src/Plugins/<Name>/), the same file and builds as
 * mygo's, downloaded into the user's cache once, as resources: [file name,
 * path], and for a universal app the darwin-amd64 build's path, which
 * combine into one file (mygo's natives). A plugin is used when the app's
 * PHP files name its namespace (MyPHP\Plugins\<Name>), as mygo's are the
 * packages the app imports. $goos is the system the app is for: libdav1d
 * ships with macOS apps alone, as Linux has it from its packages.
 *
 * @return list<array{0: string, 1: string, 2?: string}>
 */
function natives(string $appDir, string $framework, string $arch, string $goos = 'darwin'): array
{
    $sources = '';
    foreach (phpFiles($appDir, ['dist', 'vendor', 'node_modules', '.git', 'myphp']) as $f) {
        $sources .= file_get_contents($f) . "\n";
    }
    $out = []; $seen = [];
    foreach (glob("$framework/src/Plugins/*/mygo-plugin.json") ?: [] as $json) {
        $plugin = basename(dirname($json));
        if (!str_contains($sources, "MyPHP\\Plugins\\$plugin")) {
            continue;
        }
        $n = json_decode(file_get_contents($json), true, 32, JSON_THROW_ON_ERROR);
        foreach ($n['libraries'] ?? [] as $l) {
            if (isset($seen[$l['name']])) { continue; }
            $seen[$l['name']] = true;
            $pick = fn(string $target): array => $l['files'][$target] ?? fail("the $plugin plugin needs {$l['name']}, which has no build for " . str_replace('-', '/', $target));
            if ($arch === 'universal') {
                $armFile = $pick('darwin-arm64'); $amdFile = $pick('darwin-amd64');
                $armFile['name'] === $amdFile['name'] || fail("$json: {$l['name']} is {$armFile['name']} on arm64 but {$amdFile['name']} on amd64");
                $out[] = [$armFile['name'], fetchNative($armFile), fetchNative($amdFile)];
                continue;
            }
            $f = $pick("$goos-$arch");
            $out[] = [$f['name'], fetchNative($f)];
        }
    }
    if ($goos === 'darwin' && (str_contains($sources, 'MyPHP\\Media') || str_contains($sources, 'MediaPlayer'))) {
        array_push($out, ...dav1d($arch));
    }
    return $out;
}

/**
 * libdav1d, which the video player decodes AV1 with where the system does
 * not (Native\Dav1d), from this Mac's Homebrew, for an app that plays video:
 * a build of the app's architecture, none (a warning) when there is none.
 * @return list<array{0: string, 1: string}>
 */
function dav1d(string $arch): array
{
    $want = ['arm64' => MachO::CPU_ARM64, 'amd64' => MachO::CPU_AMD64][$arch] ?? null;
    foreach (['/opt/homebrew/lib/libdav1d.7.dylib', '/usr/local/lib/libdav1d.7.dylib'] as $lib) {
        $real = realpath($lib);
        if ($real !== false && $want !== null && MachO::cpu($real) === $want) {
            return [['libdav1d.7.dylib', $real]];
        }
    }
    warnf("no libdav1d for darwin/$arch (brew install dav1d): the app decodes AV1 only where the system does");
    return [];
}

/** The .php files under $dir, but in the directories $skip names. @return list<string> */
function phpFiles(string $dir, array $skip): array
{
    $out = [];
    foreach (scandir($dir) ?: [] as $name) {
        if ($name === '.' || $name === '..' || in_array($name, $skip, true)) { continue; }
        $p = "$dir/$name";
        if (is_dir($p)) {
            array_push($out, ...phpFiles($p, $skip));
        } elseif (str_ends_with($name, '.php')) {
            $out[] = $p;
        }
    }
    return $out;
}

/**
 * The path of a native library in the user's cache, downloaded there with
 * curl first when it is missing and its SHA-256 checked:
 * ~/Library/Caches/mygo/natives/<sha256>/<name> (on Linux under
 * $XDG_CACHE_HOME, else ~/.cache), where mygo's CLI keeps it
 * and the plugins look too when they run outside a built app (mygo's
 * fetchNative).
 *
 * @param array{name: string, url: string, sha256: string} $f
 */
function fetchNative(array $f): string
{
    // The SHA-256 and the name are parts of a path: a plugin may not name another file than the library it downloads.
    $name = (string)($f['name'] ?? ''); $sum = (string)($f['sha256'] ?? ''); $url = (string)($f['url'] ?? '');
    if ($url === '' || preg_match('/^[0-9a-f]{64}$/', $sum) !== 1 || $name === '' || $name === '.' || $name === '..' || strpbrk($name, '/\\') !== false) {
        fail('invalid native library ' . json_encode($f));
    }
    $xdg = (string)getenv('XDG_CACHE_HOME');
    $dir = (PHP_OS_FAMILY === 'Linux' ? ($xdg !== '' ? $xdg : getenv('HOME') . '/.cache') : getenv('HOME') . '/Library/Caches') . "/mygo/natives/$sum";
    $path = "$dir/$name";
    if (is_file($path) && hash_file('sha256', $path) === $sum) {
        return $path;
    }
    is_dir($dir) || mkdir($dir, 0755, true) || fail("cannot make $dir");
    $tmp = tempnam($dir, '.download-');
    echo "downloading $name from $url\n";
    if (sh(['curl', '-fsSL', '-o', $tmp, $url]) !== 0) {
        unlink($tmp);
        fail("downloading $name from $url failed");
    }
    if (($got = hash_file('sha256', $tmp)) !== $sum) {
        unlink($tmp);
        fail("$url has SHA-256 $got, not $sum");
    }
    chmod($tmp, 0755);
    if (!rename($tmp, $path)) {
        unlink($tmp);
        is_file($path) && hash_file('sha256', $path) === $sum || fail("cannot move the download to $path");
    }
    return $path;
}

/** Copies the tree $from to $to, but the names $skip lists, and with $hidden false those starting with a dot. */
function copyTree(string $from, string $to, array $skip, bool $hidden = true): void
{
    @mkdir($to, 0755, true);
    foreach (scandir($from) ?: fail("cannot read $from") as $name) {
        if ($name === '.' || $name === '..' || in_array($name, $skip, true) || !$hidden && $name[0] === '.') {
            continue;
        }
        is_dir("$from/$name") ? copyTree("$from/$name", "$to/$name", $skip, $hidden) : copy("$from/$name", "$to/$name");
    }
}

/**
 * A small C program as the executable: it execs the php this build found
 * (or $MYPHP_PHP) on <dir>/<entry>, in <dir>, with the arguments it was
 * given, naming its bundle in MYPHP_BUNDLE (Native\Bundle::path). <dir> is
 * the bundle's Resources/app, or with $project (the development app of
 * myphp dev) the project itself. The app then depends on that php being
 * installed, and the process is php's, not the bundle's. Needs a C
 * compiler (Xcode command line tools), which compiles it for $arch, both
 * of a universal app's.
 */
function buildExecLauncher(string $out, string $entry, string $arch, ?string $project = null): void
{
    $q = fn(string $s): string => '"' . addcslashes($s, "\"\\") . '"';
    $flags = implode(', ', array_map($q, PHP_FLAGS));
    $dir = $project === null ? 'snprintf(dir, sizeof dir, "%s/Resources/app", contents);' : 'snprintf(dir, sizeof dir, "%s", ' . $q($project) . ');';
    $php = $q(PHP_BINARY); $file = $q($entry);
    $nflags = count(PHP_FLAGS);
    $src = <<<C
    #include <mach-o/dyld.h>
    #include <stdio.h>
    #include <stdlib.h>
    #include <string.h>
    #include <unistd.h>
    #include <limits.h>
    int main(int argc, char **argv) {
        char exe[PATH_MAX], contents[PATH_MAX], dir[PATH_MAX], entry[PATH_MAX];
        uint32_t n = sizeof exe;
        if (_NSGetExecutablePath(exe, &n) != 0 || realpath(exe, contents) == NULL) { perror("launcher"); return 1; }
        char *slash = strrchr(contents, '/'); *slash = 0;  /* Contents/MacOS */
        slash = strrchr(contents, '/'); *slash = 0;        /* Contents */
        $dir
        snprintf(entry, sizeof entry, "%s/%s", dir, $file);
        char bundle[PATH_MAX];
        snprintf(bundle, sizeof bundle, "%s", contents);
        slash = strrchr(bundle, '/'); *slash = 0;          /* the .app */
        setenv("MYPHP_BUNDLE", bundle, 1);
        const char *php = getenv("MYPHP_PHP"); if (php == NULL) php = $php;
        const char *flags[] = {{$flags}};
        char **args = calloc(argc + $nflags + 2, sizeof *args);
        int i = 0;
        args[i++] = (char *)php;
        for (int f = 0; f < $nflags; f++) args[i++] = (char *)flags[f];
        args[i++] = entry;
        for (int a = 1; a < argc; a++) args[i++] = argv[a];
        if (chdir(dir) != 0) { perror("launcher: chdir"); return 1; }
        execv(php, args);
        perror("launcher: exec php");
        return 1;
    }

    C;
    $tmp = tempnam(sys_get_temp_dir(), 'myphp');
    $cFile = "$tmp.c";
    rename($tmp, $cFile);
    file_put_contents($cFile, $src);
    $archs = match ($arch) { 'arm64' => ['-arch', 'arm64'], 'amd64' => ['-arch', 'x86_64'], 'universal' => ['-arch', 'arm64', '-arch', 'x86_64'] };
    $code = sh(['cc', '-O2', '-Wall', ...$archs, '-o', $out, $cFile]);
    unlink($cFile);
    $code === 0 || fail('compiling the launcher failed (is Xcode\'s command line tools installed? xcode-select --install)');
}

/**
 * The app as one static binary: the project packed as a phar after
 * phpmicro, with the INI the app needs, inside its __LINKEDIT so that
 * codesign signs it (MachO::embed). Needs a micro.sfx with the section
 * saying where (see `myphp micro`).
 */
function buildMicroLauncher(string $out, string $appDir, string $entry, string $micro): void
{
    $phar = appPhar($appDir, $entry);
    $sfx = @file_get_contents($micro);
    $sfx !== false || fail("cannot read $micro");
    try {
        MachO::embed($sfx, MachO::microPayload(implode("\n", MICRO_INI), $phar), $out);
    } catch (RuntimeException $e) {
        fail("$micro: " . $e->getMessage());
    }
    chmod($out, 0755);
}

/** The app in $appDir packed as a phar whose stub runs $entry (or the terminal plugin's spawn.php), for phpmicro. */
function appPhar(string $appDir, string $entry): string
{
    $phar = sys_get_temp_dir() . '/myphp-' . getmypid() . '.phar';
    @unlink($phar);
    $code = sh([PHP_BINARY, '-d', 'phar.readonly=0', '-r', <<<PHP
    \$p = new Phar('$phar'); \$p->buildFromDirectory('$appDir');
    \$p->setStub("<?php Phar::mapPhar('app.phar'); if ((\\\$argv[1] ?? '') === '--myphp-pty-spawn') { require 'phar://app.phar/myphp/src/Plugins/Terminal/Pty/spawn.php'; exit(127); } require 'phar://app.phar/$entry'; __HALT_COMPILER();");
    PHP]);
    $code === 0 || fail('building the phar failed');
    try {
        return (string)file_get_contents($phar);
    } finally {
        unlink($phar);
    }
}

// ---- micro --------------------------------------------------------------
// No opcache in the static launcher: the micro SAPI's opcache crashes on
// phar:// timestamps (SIGBUS in zend_get_file_handle_timestamp) and its JIT
// segfaults on arm64 macOS, so the micro build runs the plain interpreter.
const MICRO_INI = ['ffi.enable=1', 'memory_limit=512M'];
// What the framework calls: intl from the start (I18n), xmlreader for SVG icons, curl for fetch and updates, sockets for one instance, filter.
const MICRO_EXTENSIONS = 'ffi,mbstring,ctype,phar,json,intl,xmlreader,curl,sockets,filter';
const MICRO_PHP = '8.4';
/**
 * The patch spc applies to phpmicro (`spc build -P`) as `myphp micro`
 * builds it: a __DATA,__micro_sfxsize section, which phpmicro reads for
 * where its payload starts and ends when it is set, so that the payload
 * can be inside __LINKEDIT, which codesign signs (MachO::embed). All zeros,
 * as linked, it leaves phpmicro to the end of __LINKEDIT, so spc's checks
 * of a micro.sfx with a script after it pass.
 */
const MICRO_PATCH = <<<'PHP'
<?php
if (patch_point() === 'before-php-make') {
    $f = SOURCE_PATH . '/php-src/sapi/micro/php_micro_fileinfo.c';
    $c = file_get_contents($f);
    if (!str_contains($c, 'myphp_micro_sfxsize')) {
        $find = 'if (NULL == section) {';
        if (substr_count($c, $find) !== 1) { throw new RuntimeException("myphp: $f is not the phpmicro MICRO_PATCH knows"); }
        $c = "#include <string.h>\n" . str_replace($find, 'if (NULL == section || 0 == memcmp(section, (const char[16]){0}, 16)) {', $c);
        file_put_contents($f, $c . "\n#ifdef __APPLE__\n__attribute__((used, section(\"__DATA,__micro_sfxsize\"))) unsigned char myphp_micro_sfxsize[16] = {0};\n#endif\n");
    }
}
PHP;
const SPC_NIGHTLY = 'https://dl.static-php.dev/static-php-cli/spc-bin/nightly/';

/** The spc binary: on PATH, or downloaded once to ~/.myphp/spc. */
function ensureSpc(): string
{
    $found = trim((string)shell_exec('command -v spc'));
    if ($found !== '') {
        return $found;
    }
    $home = getenv('HOME') . '/.myphp';
    $spc = "$home/spc";
    if (is_file($spc)) {
        return $spc;
    }
    @mkdir($home, 0755, true);
    $arch = hostArch() === 'arm64' ? 'aarch64' : 'x86_64';
    $url = SPC_NIGHTLY . 'spc-' . (PHP_OS_FAMILY === 'Linux' ? 'linux' : 'macos') . "-$arch";
    echo "myphp: downloading static-php-cli from $url\n";
    sh(['curl', '-fsSL', '-o', $spc, $url]) === 0 || fail("downloading spc failed; see `myphp micro --manual`");
    chmod($spc, 0755);
    return $spc;
}

/**
 * spc and a micro.sfx with MyPHP's extensions, building the latter once
 * (minutes: it compiles PHP). $MYPHP_MICRO points at a micro.sfx of your own.
 *
 * @return array{0: string, 1: string} spc path, micro.sfx path
 */
function ensureMicro(?string $phpVersion = null): array
{
    $spc = ensureSpc();
    $own = getenv('MYPHP_MICRO');
    $micro = $own ?: (getenv('HOME') . '/.myphp/micro.sfx');
    $lacks = is_file($micro) ? microLacks($micro) : '';
    if (is_file($micro) && $lacks === '') {
        return [$spc, $micro];
    }
    if (is_file($micro)) {
        $own === false || fail("$micro $lacks: build micro.sfx as `myphp micro` does (`myphp micro -manual`)");
        echo "myphp: $micro $lacks, as one of a myphp before 1.28; building it again\n";
    }
    $php = $phpVersion ?? getenv('MYPHP_PHP_VERSION') ?: MICRO_PHP;
    $build = getenv('HOME') . '/.myphp/build';
    @mkdir($build, 0755, true);
    // doctor unpacks tools (pkg-config) into its working directory, which download and build must share.
    sh([$spc, 'doctor', '--auto-fix'], $build) === 0 || fail('spc doctor found problems it could not fix');
    echo "myphp: building phpmicro $php with " . MICRO_EXTENSIONS . " in $build (once; this compiles PHP and takes a while)\n";
    sh([$spc, 'download', '--for-extensions=' . MICRO_EXTENSIONS, "--with-php=$php"], $build) === 0 || fail('spc download failed');
    if (PHP_OS_FAMILY === 'Linux') {
        // Against glibc, not musl: a fully static PHP cannot dlopen GTK through FFI. The patch is for macOS's signature alone.
        putenv('SPC_LIBC=glibc');
        sh([$spc, 'build', MICRO_EXTENSIONS, '--build-micro'], $build) === 0 || fail('spc build failed');
    } else {
        file_put_contents("$build/myphp-micro-patch.php", MICRO_PATCH) !== false || fail("cannot write $build/myphp-micro-patch.php");
        sh([$spc, 'build', MICRO_EXTENSIONS, '--build-micro', '-P', "$build/myphp-micro-patch.php"], $build) === 0 || fail('spc build failed');
    }
    $built = "$build/buildroot/bin/micro.sfx";
    is_file($built) || fail("spc built nothing at $built");
    ($lacks = microLacks($built)) === '' || fail("spc built $built, which $lacks");
    copy($built, $micro);
    chmod($micro, 0755);
    echo "myphp: micro.sfx ready at $micro\n";
    return [$spc, $micro];
}

/**
 * What the micro.sfx at $path lacks that MyPHP's apps need, '' for
 * nothing: on macOS the section MICRO_PATCH adds, which a signed app
 * needs; on Linux loading libraries through FFI, which a PHP linked
 * statically with musl cannot; and MICRO_EXTENSIONS, which it reports run
 * with a script after it.
 */
function microLacks(string $path): string
{
    if (PHP_OS_FAMILY !== 'Linux' && !MachO::hasMicroSection($path)) {
        return 'has no __DATA,' . MachO::MICRO_SECTION . ' section, which a signed app needs';
    }
    $probe = tempnam(sys_get_temp_dir(), 'myphp-micro');
    $script = '<?php echo implode(",", get_loaded_extensions());';
    if (PHP_OS_FAMILY === 'Linux') {
        $script = MachO::microPayload('ffi.enable=1', $script . ' try { FFI::cdef("int getpid(void);", "libc.so.6"); echo ",dlopen"; } catch (Throwable) {}');
    }
    copy($path, $probe) && file_put_contents($probe, $script, FILE_APPEND) || fail("cannot write $probe");
    chmod($probe, 0755);
    $loaded = array_map('strtolower', explode(',', (string)shell_exec(escapeshellarg($probe) . ' 2>/dev/null')));
    unlink($probe);
    $missing = array_diff(explode(',', MICRO_EXTENSIONS), $loaded);
    if ($missing === [] && PHP_OS_FAMILY === 'Linux' && !in_array('dlopen', $loaded, true)) {
        return 'cannot load libraries through FFI (a PHP linked statically with musl): build it against glibc, SPC_LIBC=glibc';
    }
    return $missing === [] ? '' : 'has no ' . implode(', ', $missing);
}

function micro(array $args): void
{
    help($args, "micro [-php 8.4] [-manual]\n\nGets static-php-cli and builds micro.sfx once, the static PHP that apps built\nwith -launcher micro run on; -manual prints the steps instead.");
    if (flag($args, 'manual')) {
        $ext = MICRO_EXTENSIONS; $php = MICRO_PHP; $url = SPC_NIGHTLY . 'spc-macos-aarch64';
        echo <<<TXT
        What `myphp micro` does, by hand:

          curl -fsSL -o ~/.myphp/spc $url && chmod +x ~/.myphp/spc
          mkdir -p ~/.myphp/build && cd ~/.myphp/build   # doctor, download and build share this directory
          ~/.myphp/spc doctor --auto-fix
          ~/.myphp/spc download --for-extensions=$ext --with-php=$php
          ~/.myphp/spc build $ext --build-micro -P myphp-micro-patch.php   # MICRO_PATCH of bin/myphp, saved there
          cp buildroot/bin/micro.sfx ~/.myphp/micro.sfx

        \$MYPHP_MICRO points `myphp build --launcher micro` at another micro.sfx,
        \$MYPHP_PHP_VERSION or --php picks the PHP version to build.

        TXT;
        return;
    }
    [$spc, $micro] = ensureMicro(option($args, 'php', null));
    echo "spc: $spc\nmicro.sfx: $micro\n";
}


// ---- i18n ---------------------------------------------------------------
// The catalogs of the app's messages, myphp.json's "i18n": {"dir":
// "locales", "source": "en"} (mygo's i18n): `myphp i18n check` checks them,
// and `myphp generate`, `dev` and `build` write their accessors, the class
// <Dir>.php in the catalogs' directory (Locales::filesSelected(3), which the
// app requires) and, with "bindings", the TypeScript module next to the
// client (src/locales.ts); `build` gives the bundle their localizations. The
// work is MyPHP\Native\I18nGen's.

/** @return ?array{dir: string, source: string, path: string} the "i18n" of myphp.json, or null without it */
function i18nConfig(string $dir, array $c): ?array
{
    if (!isset($c['i18n'])) {
        return null;
    }
    is_array($c['i18n']) || fail('i18n is an object: {"dir": "locales", "source": "en"}');
    $d = $c['i18n']['dir'] ?? 'locales';
    $src = $c['i18n']['source'] ?? 'en';
    is_string($d) && is_string($src) || fail('i18n.dir and i18n.source are strings');
    return ['dir' => $d, 'source' => $src, 'path' => str_starts_with($d, '/') ? $d : "$dir/$d"];
}

/** Reads and checks the catalogs of the app, against MyPHP's own, whose keys "myphp.<key>" they change. @return array{array, list<array>} */
function loadCatalogs(array $i): array
{
    is_dir($i['path']) || fail("i18n.dir {$i['dir']} is not a directory: create it with {$i['source']}.json, the messages of the source language");
    [$fw, $diags] = MyPHP\Native\I18nGen::load(FRAMEWORK . '/src/l10n', 'myphp', 'en', 'myphp');
    ($e = MyPHP\Native\I18nGen::errors($diags)) === [] || fail("MyPHP's own catalog:\n" . implode("\n", $e));
    return MyPHP\Native\I18nGen::load($i['path'], $i['dir'], $i['source'], '', ['myphp' => $fw]);
}

/** Checks the catalogs (mygo i18n check): that their messages parse, that translations have the arguments of the source language's messages and the plural forms of their languages, and which messages they lack. Errors exit with status 1; warnings do not. */
function i18nCheck(array $args): void
{
    help($args, "i18n check [dir]\n\nChecks the catalogs of the app's messages.");
    (array_shift($args) ?? '') === 'check' || fail("usage: myphp i18n check [dir]\n\nChecks the catalogs of the app's messages (i18n in myphp.json): that their\nmessages parse, that translations have the arguments of the source\nlanguage's messages and the plural forms of their languages, and which\nmessages they lack. Errors exit with status 1; warnings do not.");
    ['dir' => $dir, 'config' => $c] = project($args);
    $i = i18nConfig($dir, $c) ?? fail('the project has no catalogs: set i18n in myphp.json, as "i18n": {"dir": "locales", "source": "en"}');
    [$cat, $diags] = loadCatalogs($i);
    foreach ($diags as $d) {
        fwrite(STDERR, '  ' . MyPHP\Native\I18nGen::line($d) . "\n");
    }
    if (($n = count(MyPHP\Native\I18nGen::errors($diags))) > 0) {
        fail("$n " . ($n === 1 ? 'error' : 'errors') . ' in the catalogs');
    }
    echo 'myphp: ' . count($cat['keys']) . ' messages in ' . implode(', ', $cat['languages']) . "\n";
}

/** Writes the accessors of the catalogs where they changed, and shows the warnings of the catalogs; their errors fail it. */
function generateI18n(string $dir, array $c): void
{
    if (($i = i18nConfig($dir, $c)) === null) {
        return;
    }
    [$cat, $diags] = loadCatalogs($i);
    ($e = MyPHP\Native\I18nGen::errors($diags)) === [] || fail("the catalogs have errors (myphp i18n check lists them all):\n" . implode("\n", $e));
    $class = MyPHP\Native\I18nGen::className($i['path']);
    $files = ["{$i['path']}/$class.php" => MyPHP\Native\I18nGen::php($cat, $class)];
    if (!empty($c['bindings'])) { // the TypeScript module, next to the client, named after the catalogs' directory
        $files[dirname("$dir/{$c['bindings']}") . '/' . basename($i['path']) . '.ts'] = MyPHP\Native\I18nGen::ts($cat);
    }
    $written = [];
    foreach ($files as $path => $src) {
        if (is_file($path) && file_get_contents($path) === $src) {
            continue;
        }
        @mkdir(dirname($path), 0755, true);
        file_put_contents($path, $src) !== false || fail("cannot write $path");
        $written[] = substr($path, strlen($dir) + 1);
    }
    echo 'myphp: ' . ($written !== [] ? 'wrote ' . implode(', ', $written) : "the accessors of {$i['dir']} are up to date") . "\n";
    foreach (MyPHP\Native\I18nGen::warnings($diags) as $w) {
        fwrite(STDERR, "myphp: $w\n");
    }
}

/**
 * The languages the app ships, its own first, then the others by tag, for
 * the bundle's localizations: [tag, its name of the app (myphp.appName),
 * or '' for the app's own], none without catalogs (mygo's readLanguages).
 *
 * @return list<array{string, string}>
 */
function appLanguages(string $dir, array $c): array
{
    if (($i = i18nConfig($dir, $c)) === null) {
        return [];
    }
    $langs = [[$i['source'], '']];
    $files = glob("{$i['path']}/*.json") ?: [];
    sort($files, SORT_STRING);
    foreach ($files as $f) {
        $tag = basename($f, '.json');
        if ($tag === $i['source']) {
            continue; // the app's own name is the configuration's
        }
        $name = json_decode((string)file_get_contents($f), true)['myphp.appName'] ?? '';
        is_string($name) && !preg_match('/[\r\n]/', $name) || fail("$f: the app's name cannot break the line");
        $langs[] = [$tag, $name];
    }
    return $langs;
}

const PROFILE_AD_HOC = 'macos.provisioningProfile needs a signing identity, not ad-hoc signing: set macos.signingIdentity or pass -sign';

/**
 * Copies the app's provisioning profile (macos.provisioningProfile, a path
 * from $dir) to the bundle's Contents/embedded.provisionprofile before it is
 * signed, as restricted entitlements, such as Communication Notifications,
 * need one that authorizes them, Developer ID distribution included (mygo's
 * writeBundle and codesign). Ad-hoc signing cannot use one: $production is
 * a build, which names the configuration; dev, without -sign, is told to
 * leave the profile out of development builds.
 */
function embedProfile(string $dir, array $m, string $contents, string $identity, bool $production): void
{
    $p = $m['provisioningProfile'];
    if ($p === '') {
        return;
    }
    if ($identity === '-') {
        fail($production ? PROFILE_AD_HOC : 'macos.provisioningProfile needs a signing identity, not ad-hoc signing: pass -sign, or leave the profile out when the command is "dev"');
    }
    @copy(path($dir, $p), "$contents/embedded.provisionprofile") || fail("provisioning profile $p: " . (error_get_last()['message'] ?? 'cannot copy it'));
    chmod("$contents/embedded.provisionprofile", 0644);
}

/** The name of the localization folder of a tag in an app bundle, as Xcode names them: zh-Hans, zh-Hant or zh-HK for Chinese; the language with its script, else its region (sr-Latn, pt-BR) (mygo's lprojName). */
function lprojName(string $tag): string
{
    $parts = explode('-', $tag);
    [$lang, $script, $region] = [$parts[0], '', ''];
    foreach (array_slice($parts, 1) as $p) {
        if (strlen($p) === 4 && $script === '' && $region === '') { $script = $p; }
        elseif ($region === '' && (strlen($p) === 2 || strlen($p) === 3 && ctype_digit($p[0]))) { $region = $p; }
    }
    if ($lang === 'zh') {
        return $region === 'HK' ? 'zh-HK' : ($script === 'Hant' || $script === '' && in_array($region, ['TW', 'MO'], true) ? 'zh-Hant' : 'zh-Hans');
    }
    return $lang . ($script !== '' ? "-$script" : ($region !== '' ? "-$region" : ''));
}

/** The bundle's localizations: a folder per language the app ships, which make AppKit say its own texts in it and System Settings list it for the app, whose InfoPlist.strings names the app in it where its catalog does (myphp.appName), keeping an InfoPlist.strings the app's resources put there and the name it gives (mygo's 2e50d4d); and their Info.plist keys. @return array<string, mixed> */
function writeLocalizations(string $dir, array $c, string $resources): array
{
    $langs = appLanguages($dir, $c);
    if ($langs === []) {
        return [];
    }
    $names = [];
    foreach ($langs as [$tag, $name]) {
        $lproj = lprojName($tag);
        @mkdir("$resources/$lproj.lproj", 0755, true);
        $path = "$resources/$lproj.lproj/InfoPlist.strings";
        $strings = [];
        if (is_file($path)) { // the app's own, among its resources: its strings translate those of Info.plist, as the reasons the system gives asking for a permission
            try {
                $strings = Strings::parse((string)file_get_contents($path));
            } catch (RuntimeException $e) {
                fail("$lproj.lproj/InfoPlist.strings of the resources: " . $e->getMessage());
            }
        }
        if ($name !== '' && $name !== $c['name']) {
            $strings += ['CFBundleName' => $name, 'CFBundleDisplayName' => $name]; // where the app's own names none
        }
        if (is_link($path) || is_file($path)) { unlink($path); } // the copy of the resources keeps links: a new file, not written through one
        file_put_contents($path, Bundle::xml($strings));
        if (!in_array($lproj, $names, true)) { $names[] = $lproj; }
    }
    // The app's own language, which the system falls back to, and those it ships, which AppKit picks its texts' language among.
    return ['CFBundleDevelopmentRegion' => lprojName($langs[0][0]), 'CFBundleLocalizations' => $names];
}

/** Writes the TypeScript client and the accessors of the catalogs (mygo generate). */
function generate(array $args): void
{
    help($args, "generate [dir]\n\nWrites the typed TypeScript client for bound PHP services (bindings in\nmyphp.json), and the accessors of the app's catalogs of messages.");
    ['dir' => $dir, 'config' => $c] = project($args);
    generateI18n($dir, $c);
    generateBindings($dir, $c);
}

// ---- updates ------------------------------------------------------------
// Signed updates (App's Updater): `myphp keygen` makes the key pair, `myphp
// build` signs an archive of the app with the private key and writes
// update-<target>.json, which apps built with the public key check; the
// work is MyPHP\Native\Update\Publish's.

/** The framework's Publish, with myphp.json's "updates" (project() checked them), or null without them. */
function publisher(string $dir, array $c): ?MyPHP\Native\Update\Publish
{
    return isset($c['updates']) ? new MyPHP\Native\Update\Publish($dir, $c) : null;
}

/** The Info.plist keys that point the app for $target at its manifest. @return array<string, string> */
function updatePlist(string $dir, array $c, string $target): array
{
    return publisher($dir, $c)?->plist($target) ?? [];
}

/** The update files of the app $entry built for $target in $out. @return list<string> */
function writeUpdate(string $dir, array $c, string $out, string $entry, string $target): array
{
    return publisher($dir, $c)?->write($out, $entry, $target, fn(string $line) => logf($line)) ?? [];
}

/** Creates the Ed25519 key pair that signs updates (mygo's keygen). */
function keygen(array $args): void
{
    help($args, "keygen [-out dir] [-force]\n\nCreates the key pair that signs updates.");
    $out = option($args, 'out', getenv('HOME') . '/Library/Application Support/myphp/update-keys');
    try {
        echo MyPHP\Native\Update\Publish::keygen($out, flag($args, 'force'));
    } catch (RuntimeException $e) {
        fail($e->getMessage());
    }
}

// ---- screenshot -----------------------------------------------------------
const SCREENSHOT_USAGE = <<<'TXT'
screenshot [flags] [dir | file.php]

Runs the app of the project in dir (default .) once, from its files, or
the script file.php as the entry of the project in its folder, and
saves a PNG of its window once it is drawn and has settled (a web page:
loaded, its calls of PHP methods answered, two frames drawn), so that a
coding agent or a script sees what the app shows; then quits it. The app
needs no change: run from its project in development with MYPHP_AUTOMATION
set, it is driven by the automation plugin (docs/automation.md), here on a
socket of its own. The roles and labels of the elements the window shows,
as assistive technology reads them, are printed; -tree writes them all as
JSON, the tree request's answer, for agents that read no images.

On Linux without a display (DISPLAY and WAYLAND_DISPLAY unset), the app
runs on an X server of its own, Xvfb, which this starts. A frontend shows
from frontendDist, built: devCommand and devUrl are left alone.

It exits with status 1 when the app exits before it is captured (its
output is shown), shows no window, or does not settle in time; stopped by
a signal (Ctrl-C, a timeout's SIGTERM), it ends the app and Xvfb first.

Flags:
  -out file      the PNG (default <dir>/.myphp/screenshot.png)
  -tree file     write the window's elements as JSON too (a web page has
                 none: its PNG alone, with a warning)
  -window N      the window, by the ID the automation plugin lists (default:
                 the focused window, else the first that shows)
  -size WxH      resize the window's content to W×H points before capturing
  -theme t       show the app light or dark, whatever the system's appearance
  -data dir      keep the app's data in dir (made if missing), not the user's:
                 App::path's UserData, Cache and Logs; on Linux XDG_CONFIG_HOME,
                 XDG_CACHE_HOME, XDG_DATA_HOME and XDG_STATE_HOME under it
  -timeout s     seconds to wait for the window and for it to settle (default 30)
TXT;

function screenshot(array $args): void
{
    help($args, SCREENSHOT_USAGE);
    $out = option($args, 'out');
    $treeOut = option($args, 'tree');
    $want = option($args, 'window', '0');
    $size = option($args, 'size');
    $theme = option($args, 'theme');
    $data = option($args, 'data');
    $timeout = option($args, 'timeout', '30');
    $theme === null || in_array($theme, ['light', 'dark'], true) || fail("-theme \"$theme\" is not light or dark");
    preg_match('/^\d+$/', $want) === 1 || fail("-window \"$want\" is not the ID of a window");
    is_numeric($timeout) && (float)$timeout > 0 || fail("-timeout \"$timeout\" is not a number of seconds");
    $wh = null;
    if ($size !== null) {
        preg_match('/^(\d+)x(\d+)$/', $size, $m) === 1 && (int)$m[1] > 0 && (int)$m[2] > 0 || fail("-size \"$size\" is not WxH in points, as 800x600");
        $wh = [(int)$m[1], (int)$m[2]];
    }
    count($args) <= 1 || fail('expected at most one project directory or PHP file');
    $file = isset($args[0]) && is_file($args[0]) ? $args[0] : null; // a script: its folder the project, it the entry, whatever the config names
    $file === null || str_ends_with($file, '.php') || fail("$file is not a PHP file");
    ['dir' => $dir, 'config' => $c] = project($file === null ? $args : [dirname($file)]);
    $entry = $file === null ? path($dir, $c['entry']) : (string)realpath($file);
    is_file($entry) || fail("$entry does not exist: name the app's entry with \"entry\" in {$c['configFile']}");
    $out = $out === null ? "$dir/.myphp/screenshot.png" : path((string)getcwd(), $out);
    $treeOut = $treeOut === null ? null : path((string)getcwd(), $treeOut);
    generateI18n($dir, $c); // the app loads the accessors of its catalogs
    $deadline = microtime(true) + (float)$timeout;
    $tmp = sys_get_temp_dir() . '/myphp-screenshot-' . getmypid(); // short: a socket's path has about 100 bytes
    @mkdir($tmp, 0700) || fail("cannot create $tmp");
    $env = ['MYPHP_AUTOMATION' => "$tmp/app.sock", 'MYPHP_ENV' => 'development', 'MYPHP_HOME' => frameworkOf($c)];
    if ($theme !== null) {
        $env['MYPHP_THEME'] = $theme; // App::run's Theme::setSource, in a run from the project in development
    }
    if ($data !== null) { // the app's data apart from the user's: MYPHP_DATA_HOME stands for ~/Library on the Mac (App::path), XDG's on Linux
        $data = path((string)getcwd(), $data);
        is_dir($data) || @mkdir($data, 0755, true) || fail("cannot create $data");
        $env['MYPHP_DATA_HOME'] = $data;
        if (PHP_OS_FAMILY === 'Linux') {
            $env += ['XDG_CONFIG_HOME' => "$data/config", 'XDG_CACHE_HOME' => "$data/cache", 'XDG_DATA_HOME' => "$data/data", 'XDG_STATE_HOME' => "$data/state"];
        }
    }
    if (($c['frontendDist'] ?? '') !== '') {
        $env['MYPHP_FRONTEND_DIST'] = path($dir, $c['frontendDist']);
    }
    $xvfb = $app = null;
    // Stopped by a signal (Ctrl-C, a tool's timeout), it fails as on an error, so that the finally below ends the app and
    // Xvfb rather than leave them running; SIGKILL alone cannot be caught.
    if (function_exists('pcntl_async_signals')) {
        pcntl_async_signals(true);
        foreach ([SIGTERM, SIGINT, SIGHUP] as $sig) {
            pcntl_signal($sig, fn(int $n) => fail("stopped by signal $n"));
        }
    }
    try {
        if (PHP_OS_FAMILY === 'Linux' && (string)getenv('DISPLAY') === '' && (string)getenv('WAYLAND_DISPLAY') === '') {
            [$xvfb, $env['DISPLAY']] = startXvfb($tmp, $deadline);
        }
        $log = "$tmp/app.log";
        $app = proc_open([PHP_BINARY, ...PHP_FLAGS, $entry], [0 => ['file', '/dev/null', 'r'], 1 => ['file', $log, 'a'], 2 => ['file', $log, 'a']], $pipes, $dir, $env + getenv());
        $app !== false || fail("cannot run $entry");
        $s = new ScreenshotSession($app, $log, $env['MYPHP_AUTOMATION'], $deadline, (float)$timeout);
        $s->connect();
        $w = $s->window((int)$want);
        if ($treeOut !== null && $w['kind'] !== 'content') {
            warnf("window {$w['id']} shows a web page, which has no tree of elements: saving its PNG alone; read the page with eval (docs/automation.md)");
            $treeOut = null;
        }
        if ($wh !== null) {
            $s->resize($w['id'], ...$wh);
        }
        [$png, $pw, $ph] = $s->capture($w['id'], $wh, $w['kind'] !== 'content');
        $tree = $w['kind'] === 'content' ? $s->call('tree', ['window' => $w['id']]) : null;
        is_dir(dirname($out)) || @mkdir(dirname($out), 0755, true) || fail('cannot create ' . dirname($out));
        file_put_contents($out, $png) !== false || fail("cannot write $out");
        logf("Saved $out: " . json_encode($w['title'], JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) . ", window {$w['id']}, {$pw}×{$ph} pixels");
        if ($tree !== null) {
            if ($treeOut !== null) {
                is_dir(dirname($treeOut)) || @mkdir(dirname($treeOut), 0755, true) || fail('cannot create ' . dirname($treeOut));
                file_put_contents($treeOut, json_encode($tree, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE) . "\n") !== false || fail("cannot write $treeOut");
                logf("Saved $treeOut: " . count($tree['nodes']) . ' elements');
            }
            echo treeSummary($tree);
        }
        $s->quit();
        $app = null;
    } finally {
        if ($app !== null) { // a run that failed: the app asked to quit too, then killed
            proc_terminate($app, 15);
            for ($end = microtime(true) + 2; proc_get_status($app)['running'] && microtime(true) < $end;) {
                usleep(20_000);
            }
            if (proc_get_status($app)['running']) {
                proc_terminate($app, 9);
            }
            proc_close($app);
        }
        if ($xvfb !== null) {
            proc_terminate($xvfb, 15);
            proc_close($xvfb);
        }
        array_map('unlink', glob("$tmp/*")); // the socket, the logs
        @rmdir($tmp);
        if (function_exists('pcntl_signal')) {
            foreach ([SIGTERM, SIGINT, SIGHUP] as $sig) { pcntl_signal($sig, SIG_DFL); }
        }
    }
}

/**
 * Starts Xvfb on a display it picks (-displayfd): its process and the
 * display's name, once it takes connections.
 * @return array{0: resource, 1: string}
 */
function startXvfb(string $tmp, float $deadline): array
{
    $bin = Cmd::look('Xvfb');
    $bin !== '' || fail("no display (DISPLAY and WAYLAND_DISPLAY are unset) and no Xvfb to start one: install it (Debian, Ubuntu: apt install xvfb; Fedora: dnf install xorg-x11-server-Xvfb; Arch: pacman -S xorg-server-xvfb), or run where there is a display");
    $p = proc_open([$bin, '-displayfd', '3', '-screen', '0', '2560x1600x24', '-nolisten', 'tcp'], [0 => ['file', '/dev/null', 'r'], 1 => ['file', "$tmp/xvfb.log", 'a'], 2 => ['file', "$tmp/xvfb.log", 'a'], 3 => ['pipe', 'w']], $pipes);
    $p !== false || fail("cannot run $bin");
    $line = '';
    while (!str_contains($line, "\n")) {
        $r = [$pipes[3]]; $w = $e = null;
        $left = $deadline - microtime(true);
        if ($left <= 0 || @stream_select($r, $w, $e, (int)$left, (int)(fmod($left, 1) * 1e6)) < 1) {
            proc_terminate($p, 9);
            fail("Xvfb did not start:\n" . tail("$tmp/xvfb.log"));
        }
        $b = fread($pipes[3], 64);
        if ($b === '' || $b === false) {
            fail("Xvfb exited:\n" . tail("$tmp/xvfb.log"));
        }
        $line .= $b;
    }
    fclose($pipes[3]);
    return [$p, ':' . trim($line)];
}

/** The last lines of a log, indented, or a note that it is empty. */
function tail(string $path, int $lines = 20): string
{
    $all = preg_split('/\R/', rtrim((string)@file_get_contents($path)));
    $all = array_slice($all, -$lines);
    return $all === [''] ? '  (no output)' : '  ' . implode("\n  ", $all);
}

/** The roles, labels and keys of a tree's elements, indented as they nest; the first 60. */
function treeSummary(array $tree): string
{
    $depth = [];
    $lines = [];
    foreach ($tree['nodes'] as $n) {
        $d = isset($n['parent']) ? ($depth[$n['parent']] ?? 0) + 1 : 0;
        $depth[$n['id']] = $d;
        $what = $n['role'];
        foreach (['label', 'value'] as $f) {
            if (isset($n[$f]) && $n[$f] !== '') {
                $what .= ' ' . json_encode($n[$f], JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES);
            }
        }
        if (isset($n['key'])) {
            $what .= ' key=' . json_encode($n['key'], JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES);
        }
        if (in_array('disabled', $n['states'] ?? [], true)) {
            $what .= ' (disabled)';
        }
        $lines[] = str_repeat('  ', $d + 1) . $what;
    }
    $more = count($lines) - 60;
    return "Elements:\n" . implode("\n", array_slice($lines, 0, 60)) . "\n" . ($more > 0 ? "  … and $more more (-tree writes them all)\n" : '');
}

/**
 * The app myphp screenshot runs, driven over the automation plugin's
 * socket (docs/automation.md): each request answered, or the run fails
 * with why, the app's output when it ended.
 */
final class ScreenshotSession
{
    /** @var resource|null */
    private $conn = null;
    private int $id = 0;

    /** @param resource $app */
    public function __construct(private $app, private readonly string $log, private readonly string $sock, private readonly float $deadline, private readonly float $timeout) {}

    /** Fails when the app has ended. */
    private function alive(string $before): void
    {
        $st = proc_get_status($this->app);
        if (!$st['running']) {
            fail("the app exited (status {$st['exitcode']}) $before:\n" . tail($this->log));
        }
    }

    /** Waits for the app to listen, and connects. */
    public function connect(): void
    {
        while (true) {
            $this->alive('before it listened');
            if (file_exists($this->sock) && ($c = @stream_socket_client("unix://{$this->sock}", $errno, $err, 1.0)) !== false) {
                $this->conn = $c;
                return;
            }
            microtime(true) < $this->deadline || fail("the app did not listen for automation in {$this->timeout} s; it calls App::run(), from its project? Its output:\n" . tail($this->log));
            usleep(50_000);
        }
    }

    /** The result of a request; its error's code and message fail the run, but for the codes in $tolerate, which come back as ['error' => code]. */
    public function call(string $method, array $params = [], array $tolerate = []): array
    {
        $line = json_encode(['id' => ++$this->id, 'method' => $method, 'params' => (object)$params], JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE) . "\n";
        $answer = @fwrite($this->conn, $line) === strlen($line) ? $this->read() : false;
        if ($answer === false) {
            $this->alive("as it was asked to $method");
            fail("the app did not answer $method in {$this->timeout} s");
        }
        $m = json_decode($answer, true);
        if (isset($m['error'])) {
            if (in_array($m['error']['code'], $tolerate, true)) {
                return ['error' => $m['error']['code']];
            }
            fail("$method: {$m['error']['message']} ({$m['error']['code']})");
        }
        return (array)$m['result'];
    }

    /** A line of the answer, while the app runs, for up to the timeout: the waits that take long (idle) are given less. */
    private function read(): string|false
    {
        $line = '';
        $end = microtime(true) + $this->timeout;
        while (!str_ends_with($line, "\n")) {
            $r = [$this->conn]; $w = $e = null;
            if (microtime(true) > $end || @stream_select($r, $w, $e, 0, 200_000) === false) {
                return false;
            }
            if ($r === []) {
                if (!proc_get_status($this->app)['running']) { return false; }
                continue;
            }
            $b = fread($this->conn, 1 << 16);
            if ($b === '' || $b === false) {
                return false;
            }
            $line .= $b;
        }
        return $line;
    }

    /** The window $id once the app lists it, or for 0 the focused one that shows, else the first that shows. */
    public function window(int $id): array
    {
        while (true) {
            $late = microtime(true) >= $this->deadline;
            $all = $this->call('windows')['windows'];
            $shown = array_values(array_filter($all, fn(array $w) => $w['visible']));
            $w = $id !== 0 ? (array_column($all, null, 'id')[$id] ?? null) : (array_values(array_filter($shown, fn(array $w) => $w['focused']))[0] ?? $shown[0] ?? null);
            if ($w !== null) {
                return $w;
            }
            if ($late) {
                $ids = implode(', ', array_map(fn(array $w) => $w['id'] . ' ' . json_encode($w['title'], JSON_UNESCAPED_UNICODE), $all));
                fail(($id !== 0 ? "no window $id" : 'no window shows') . " after {$this->timeout} s" . ($all !== [] ? " (the app's windows: $ids)" : '') . "; its output:\n" . tail($this->log));
            }
            usleep(100_000);
        }
    }

    /** Resizes the window's content, and waits until its bounds say so. */
    public function resize(int $id, int $width, int $height): void
    {
        $this->call('resize', ['window' => $id, 'width' => $width, 'height' => $height]);
        while (true) {
            $late = microtime(true) >= $this->deadline;
            $w = array_column($this->call('windows')['windows'], null, 'id')[$id] ?? fail("window $id closed");
            $b = $w['contentBounds'];
            if ((int)round($b['width']) === $width && (int)round($b['height']) === $height) {
                return;
            }
            !$late || fail("window $id did not take the size {$width}x$height in {$this->timeout} s: its content is " . round($b['width']) . 'x' . round($b['height']) . ' (its limits, or the screen, may keep it)');
            usleep(50_000);
        }
    }

    /**
     * A PNG of the window once it has settled, and its size in pixels;
     * with $size, once the frame captured is of that size in points. A
     * $page settles once it loaded (idle, mygo's) and then its calls of PHP
     * methods were answered and it drew two frames more, twice in a row: what
     * it renders from their replies shows.
     * @return array{0: string, 1: int, 2: int}
     */
    public function capture(int $id, ?array $size, bool $page = false): array
    {
        while (true) {
            $late = microtime(true) >= $this->deadline;
            $left = (int)(($this->deadline - microtime(true)) * 1000);
            $left > 0 && !isset($this->call('idle', ['window' => $id, 'timeout' => $left], ['timeout'])['error'])
                || fail("window $id still draws after {$this->timeout} s (an animation that never ends?)");
            if ($page) {
                $waiting = $this->call('eval', ['window' => $id, 'script' => self::settle($left)])['value'] ?? 0;
                $waiting === 0 || warnf("window $id: $waiting calls of PHP methods still unanswered after {$this->timeout} s; captured as it is");
            }
            $r = $this->call('capture', ['window' => $id]);
            $png = base64_decode($r['png'], true);
            ($png !== false && $r['width'] > 0) || fail("capture: window $id gave no image");
            if ($size === null || abs($r['height'] - $size[1] * $r['width'] / $size[0]) < 2 * $r['width'] / $size[0]) {
                return [$png, $r['width'], $r['height']];
            }
            !$late || fail("window $id did not draw at {$size[0]}x{$size[1]} in {$this->timeout} s: its frame is {$r['width']}×{$r['height']} pixels");
            usleep(50_000);
        }
    }

    /** The script that waits, for up to $ms milliseconds, until the page has no call of a PHP method waiting for its reply over two frames, twice in a row; it returns how many still wait. */
    private static function settle(int $ms): string
    {
        return 'const frames = () => new Promise((r) => requestAnimationFrame(() => requestAnimationFrame(r)));'
            . ' const calls = () => window.__myphp?.calls?.() ?? 0;'
            . " const end = Date.now() + $ms; let quiet = 0;"
            . ' while (quiet < 2 && Date.now() < end) { await frames(); quiet = calls() === 0 ? quiet + 1 : 0; }'
            . ' return calls();';
    }

    /** Asks the app to quit, as Quit (SIGTERM), and waits for it; kills it after 5 seconds. */
    public function quit(): void
    {
        fclose($this->conn);
        proc_terminate($this->app, 15);
        for ($end = microtime(true) + 5; proc_get_status($this->app)['running'] && microtime(true) < $end;) {
            usleep(20_000);
        }
        if (proc_get_status($this->app)['running']) {
            warnf("the app did not quit within 5 seconds of SIGTERM: killed it");
            proc_terminate($this->app, 9);
        }
        proc_close($this->app);
    }
}

// ---- doctor, skills -----------------------------------------------------
/** Checks the tools MyPHP needs (mygo's doctor): failed checks exit with status 1. */
function doctor(array $args): void
{
    help($args, "doctor\n\nChecks the tools and system libraries MyPHP needs.");
    $ok = true;
    $check = function (string $name, bool $good, string $detail) use (&$ok): void {
        if (!$good) { $ok = false; }
        printf("%s %-10s %s\n", $good ? "\033[32m✓\033[0m" : "\033[31m✗\033[0m", $name, $detail);
    };
    $optional = function (string $name, string $feature, string $found): void {
        if ($found !== '') {
            printf("\033[32m✓\033[0m %-10s %s\n", $name, $found);
        } else {
            printf("- %-10s not found (optional: %s)\n", $name, $feature);
        }
    };
    $check('php', PHP_VERSION_ID >= 80300 && extension_loaded('ffi'), PHP_VERSION . (extension_loaded('ffi') ? ' with FFI' : ' without the FFI extension, which MyPHP needs') . ' (8.3 or later is required)');
    $bun = trim((string)shell_exec('bun --version 2>/dev/null'));
    $bun !== '' ? $check('bun', true, $bun) : print("- bun        not found (optional, used by the web template: https://bun.sh)\n");
    if (PHP_OS_FAMILY === 'Darwin') {
        $v = trim((string)shell_exec('sw_vers -productVersion'));
        $check('macOS', (int)explode('.', $v)[0] >= 12, "$v (macOS 12 or later is required)");
        $check('cc', trim((string)shell_exec('command -v cc')) !== '', 'the C compiler of the exec launcher (xcode-select --install)');
    } else {
        $check(PHP_OS_FAMILY, false, 'no MyPHP backend for this platform yet');
    }
    $optional('gh', 'myphp build -upload to GitHub releases, https://cli.github.com', MyPHP\Native\Build\Cmd::look('gh'));
    if (PHP_OS_FAMILY === 'Darwin') {
        $ids = substr_count((string)shell_exec('security find-identity -v -p codesigning 2>/dev/null'), 'Developer ID Application');
        $optional('codesign', 'a Developer ID to sign apps for other Macs', $ids > 0 ? "$ids Developer ID identities" : '');
    }
    $spc = trim((string)shell_exec('command -v spc')) ?: (is_file(getenv('HOME') . '/.myphp/spc') ? getenv('HOME') . '/.myphp/spc' : '');
    $optional('spc', 'myphp build -launcher micro, which myphp micro sets up', $spc);
    $ok || fail('some checks failed');
}

const SKILLS = __DIR__ . '/skills'; // the bundled skills, which apps do not ship

/** Installs or updates the bundled agent skills in <dir>/.agents/skills (mygo's install-skills): replaces the bundled skill files, preserving unrelated files and skills. */
function installSkills(array $args): void
{
    help($args, "install-skills [dir]\n\nInstalls or updates the bundled MyPHP agent skills in .agents/skills.\nReplaces bundled skill files, preserving unrelated files and skills.");
    count($args) <= 1 || fail('expected at most one project directory');
    $dir = $args[0] ?? '.';
    is_dir($dir) || fail("$dir is not a directory");
    writeSkills($dir);
    logf('Installed skills in ' . rtrim($dir, '/') . '/.agents/skills');
}

function writeSkills(string $dir): void
{
    copyTree(SKILLS, "$dir/.agents/skills", []);
}

// ---- main ---------------------------------------------------------------
$args = array_slice($_SERVER['argv'], 1);
$cmd = array_shift($args);
if ($cmd === null) {
    fwrite(STDERR, USAGE);
    exit(2);
}
try {
    run($cmd, $args);
} catch (Failure $e) {
    fwrite(STDERR, "myphp: {$e->getMessage()}\n");
    exit(1);
}

function run(string $cmd, array $args): void
{
    $GLOBALS['running'] = $cmd === 'gen' ? 'generate' : $cmd;
    match ($cmd) {
        'init' => init($args),
        'install-skills' => installSkills($args),
        'dev' => dev($args),
        'generate', 'gen' => generate($args),
        'i18n' => i18nCheck($args),
        'build' => build($args),
        'screenshot' => screenshot($args),
        'micro' => micro($args),
        'keygen' => keygen($args),
        'doctor' => doctor($args),
        'version', '-v', '--version' => print('myphp ' . VERSION . "\n"),
        'help', '-h', '--help' => print(USAGE),
        default => (function () use ($cmd): never { fwrite(STDERR, "myphp: unknown command \"$cmd\"\n\n" . USAGE); exit(2); })(),
    };
}
