{
    "name": "owner888/myphp",
    "description": "Desktop apps in PHP, with native UI or a web frontend, over ext-ffi.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "ext-ffi": "*"
    },
    "autoload": {
        "psr-4": { "MyPHP\\": "src/" },
        "files": ["src/UI/Declarative/functions.php"]
    },
    "config": { "sort-packages": true }
}
