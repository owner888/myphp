{
  // The TypeScript of the repository (tsc -p . checks it): myphp-runtime
  // (packages/runtime), which the plugins' clients and the modules myphp
  // generate writes import, resolved here from its sources, as Bun does.
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "paths": {
      "myphp-runtime": ["./packages/runtime/src/index.ts"],
      "myphp-runtime/*": ["./packages/runtime/src/*.ts"]
    }
  },
  "include": ["packages", "src", "tests/i18n"],
  // The tests run in Bun, whose types are not a dependency: bun test checks them.
  "exclude": ["**/node_modules", "**/*.test.ts", "src/Plugins/fake-myphp.ts"]
}
